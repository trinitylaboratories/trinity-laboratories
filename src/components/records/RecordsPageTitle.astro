---
type RecordsTitleData = {
  title: string;
  recordId?: string;
  recordType?: string;
};

const data = Astro.locals.starlightRoute.entry.data as RecordsTitleData;
const protectedForm = data.recordType === 'form-template' && Boolean(data.recordId);
---

<h1 id="_top" tabindex="-1">
  {
    protectedForm ? (
      <>
        <span data-protected-record-title={data.recordId} hidden>
          {data.title}
        </span>
        <span data-protected-record-title-fallback={data.recordId}>
          {data.recordId} — Controlled form template
        </span>
      </>
    ) : (
      data.title
    )
  }
</h1>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      color: var(--sl-color-white);
      font-size: var(--sl-text-h1);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
    }
  }
</style>
