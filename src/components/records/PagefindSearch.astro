---
import '@pagefind/default-ui/css/ui.css';
---

<section class="tirn-page-search" aria-labelledby="tirn-search-label">
  <div class="tirn-page-search__heading">
    <p id="tirn-search-label">Archive query</p>
    <span>Released records only</span>
  </div>
  <p class="tirn-page-search__loading" data-search-loading role="status">
    Initializing records index…
  </p>
  <div id="tirn-pagefind-search"></div>
  <noscript>
    <p class="tirn-page-search__notice">
      Search is unavailable on this terminal. Direct record links remain available in the records
      indexes.
    </p>
  </noscript>
</section>

<script>
  async function initializeRecordsSearch() {
    const mount = document.querySelector<HTMLElement>('#tirn-pagefind-search');
    const loading = document.querySelector<HTMLElement>('[data-search-loading]');
    if (!mount || mount.dataset.initialized === 'true') return;

    try {
      // @ts-expect-error — @pagefind/default-ui does not publish TypeScript declarations.
      const { PagefindUI } = await import('@pagefind/default-ui');
      new PagefindUI({
        element: '#tirn-pagefind-search',
        bundlePath: '/pagefind/',
        showImages: false,
        showSubResults: true,
        translations: {
          placeholder: 'Search released records',
        },
      });
      mount.dataset.initialized = 'true';
      loading?.remove();
    } catch {
      if (loading) loading.textContent = 'The records index is temporarily unavailable.';
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeRecordsSearch, { once: true });
  } else {
    initializeRecordsSearch();
  }
</script>

<style>
  .tirn-page-search {
    margin-block: 2rem 3rem;
    border-top: 4px solid #0759c7;
    border-bottom: 1px solid #9a9892;
    padding-block: 1rem 2rem;
  }

  .tirn-page-search__heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    font: 400 0.72rem/1.3 var(--sl-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tirn-page-search__heading p,
  .tirn-page-search__loading,
  .tirn-page-search__notice {
    margin: 0;
  }

  .tirn-page-search__heading p {
    color: #0759c7;
    font-weight: 700;
  }

  .tirn-page-search__heading span,
  .tirn-page-search__loading,
  .tirn-page-search__notice {
    color: #5a6570;
  }

  .tirn-page-search__loading,
  .tirn-page-search__notice {
    padding-block: 1rem;
  }
</style>

<style is:global>
  #tirn-pagefind-search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #0759c7;
    --pagefind-ui-text: #161b22;
    --pagefind-ui-background: #f4f1e8;
    --pagefind-ui-border: #87909a;
    --pagefind-ui-tag: #e7e4dc;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-image-border-radius: 0;
    --pagefind-ui-font: var(--sl-font);
  }

  #tirn-pagefind-search .pagefind-ui__search-input {
    border-inline-width: 0 0;
    border-top-color: #87909a;
    border-bottom: 2px solid #161b22;
    box-shadow: none;
    color: #10161d;
    font-family: var(--sl-font-mono);
    font-weight: 400;
  }

  #tirn-pagefind-search .pagefind-ui__form::before {
    top: 1.35rem;
    left: 1.25rem;
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid #161b22;
    border-radius: 50%;
    background: transparent;
    box-sizing: border-box;
    opacity: 0.7;
    -webkit-mask-image: none;
    mask-image: none;
  }

  #tirn-pagefind-search .pagefind-ui__form::after {
    position: absolute;
    z-index: 9;
    top: 2.18rem;
    left: 2.02rem;
    width: 0.5rem;
    height: 2px;
    background: #161b22;
    content: '';
    opacity: 0.7;
    pointer-events: none;
    transform: rotate(45deg);
    transform-origin: left center;
  }

  #tirn-pagefind-search .pagefind-ui__search-input:focus {
    border-bottom-color: #0759c7;
    outline: 2px solid transparent;
  }

  #tirn-pagefind-search .pagefind-ui__search-clear {
    border-radius: 0;
    background: #e7e4dc;
    color: #0759c7;
  }

  #tirn-pagefind-search .pagefind-ui__result {
    border-top: 1px solid #b7b4ac;
    padding-block: 1.25rem;
  }

  #tirn-pagefind-search .pagefind-ui__result-link {
    color: #0754bb;
    font-weight: 650;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  #tirn-pagefind-search .pagefind-ui__result-excerpt {
    color: #313a44;
  }

  #tirn-pagefind-search mark {
    background: #d9e9ff;
    color: #10161d;
  }
</style>
