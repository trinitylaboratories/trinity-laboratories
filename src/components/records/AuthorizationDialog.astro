---
import type { TirnLevel } from '../../lib/tirn-access';

interface Props {
  id: string;
  requiredLevel?: TirnLevel;
  program?: string;
  compartment?: string;
  triggerLabel?: string;
}

const {
  id,
  requiredLevel = 'TL-3',
  program,
  compartment,
  triggerLabel = 'Authorize',
} = Astro.props;
const dialogId = `${id}-authorization-dialog`;
const dialogTitleId = `${id}-authorization-title`;
const dialogDescriptionId = `${id}-authorization-description`;
---

<div
  class="authorization-control"
  data-authorization-control
  data-required-level={requiredLevel}
  data-program={program}
  data-compartment={compartment}
>
  <button
    class="authorization-trigger"
    type="button"
    data-authorize-trigger
    aria-haspopup="dialog"
    aria-controls={dialogId}
    disabled
  >
    {triggerLabel}
  </button>

  <dialog
    class="authorization-dialog"
    id={dialogId}
    data-authorization-dialog
    aria-labelledby={dialogTitleId}
    aria-describedby={dialogDescriptionId}
  >
    <div class="authorization-dialog__heading">
      <div>
        <p>Access control / temporary grant</p>
        <h2 id={dialogTitleId}>Authorize controlled information</h2>
      </div>
      <button type="button" data-authorization-close aria-label="Close authorization console">
        Close
      </button>
    </div>

    <div class="authorization-dialog__body">
      <dl>
        <div><dt>Required eligibility</dt><dd>{requiredLevel}</dd></div>
        <div><dt>Program</dt><dd>{program ?? 'Not specified'}</dd></div>
        <div><dt>Compartment</dt><dd>{compartment ?? 'Not specified'}</dd></div>
        <div><dt>Grant duration</dt><dd>15 minutes</dd></div>
      </dl>

      <p class="authorization-dialog__notice" id={dialogDescriptionId}>
        Eligibility does not establish need-to-know. State the working purpose and enter the
        authorization credential issued for this release set.
      </p>

      <form data-authorization-form novalidate autocomplete="off">
        <fieldset disabled data-authorization-fields>
          <label>
            Working purpose
            <select data-authorization-purpose required autocomplete="off">
              <option value="">Select a purpose</option>
              <option value="record-review">Record review</option>
              <option value="required-training">Required training</option>
              <option value="records-administration">Records administration</option>
            </select>
          </label>

          <label>
            Authorization credential
            <input
              type="password"
              data-authorization-credential
              required
              minlength="16"
              maxlength="128"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
            />
          </label>

          <label class="authorization-dialog__attestation">
            <input type="checkbox" data-authorization-attestation required />
            <span>I attest that the requested information is required for the stated purpose.</span>
          </label>

          <button class="authorization-submit" type="submit">Evaluate authorization</button>
        </fieldset>
      </form>

      <p class="authorization-dialog__status" role="status" aria-live="polite" data-auth-status>
        Authorization console initialization required.
      </p>
      <p class="authorization-dialog__privacy">
        Credential and purpose values are evaluated in this page, cleared after each attempt, and
        are not transmitted or retained.
      </p>
    </div>
  </dialog>
</div>

<script>
  import {
    accessAllows,
    parseElevatedGrant,
    resolveTirnAccess,
    serializeElevatedGrant,
    TIRN_ACCESS_CHANGE_EVENT,
    TIRN_GRANT_STORAGE_KEY,
    TIRN_SESSION_STORAGE_KEY,
    verifyAuthorizationCredential,
    type TirnLevel,
  } from '../../lib/tirn-access';

  const initializeAuthorizationControl = (root: HTMLElement) => {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const trigger = root.querySelector<HTMLButtonElement>('[data-authorize-trigger]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-authorization-dialog]');
    const close = root.querySelector<HTMLButtonElement>('[data-authorization-close]');
    const form = root.querySelector<HTMLFormElement>('[data-authorization-form]');
    const fields = root.querySelector<HTMLFieldSetElement>('[data-authorization-fields]');
    const purpose = root.querySelector<HTMLSelectElement>('[data-authorization-purpose]');
    const credential = root.querySelector<HTMLInputElement>('[data-authorization-credential]');
    const attestation = root.querySelector<HTMLInputElement>('[data-authorization-attestation]');
    const status = root.querySelector<HTMLElement>('[data-auth-status]');
    const requiredLevel = (root.dataset.requiredLevel || 'TL-3') as TirnLevel;
    const hasAdditionalControl = Boolean(root.dataset.program || root.dataset.compartment);

    const getValue = (key: string) => {
      try {
        return sessionStorage.getItem(key);
      } catch {
        return null;
      }
    };

    const clearInputs = () => {
      if (credential) credential.value = '';
      if (purpose) purpose.value = '';
      if (attestation) attestation.checked = false;
    };

    const currentAccessAllows = () => {
      const now = Date.now();
      const state = resolveTirnAccess(
        getValue(TIRN_SESSION_STORAGE_KEY),
        getValue(TIRN_GRANT_STORAGE_KEY),
        now,
      );
      return !hasAdditionalControl && accessAllows(state, requiredLevel);
    };

    const updateTrigger = () => {
      if (!trigger) return;
      trigger.textContent = currentAccessAllows() ? 'Authorization active' : 'Authorize';
    };

    if (trigger && fields && status) {
      trigger.disabled = false;
      fields.disabled = false;
      status.textContent = 'Console ready. Authorization values are required.';
      updateTrigger();
    }

    trigger?.addEventListener('click', () => {
      if (!dialog) return;
      clearInputs();
      if (status) {
        status.textContent = currentAccessAllows()
          ? 'A qualifying temporary authorization is already active.'
          : 'Console ready. Authorization values are required.';
      }
      dialog.showModal();
      purpose?.focus();
    });

    const closeDialog = () => {
      clearInputs();
      dialog?.close();
      trigger?.focus();
    };

    close?.addEventListener('click', closeDialog);
    dialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeDialog();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const inputValue = credential?.value ?? '';
      const hasPurpose = Boolean(purpose?.value);
      const hasAttestation = Boolean(attestation?.checked);

      if (!form.checkValidity() || !hasPurpose || !hasAttestation) {
        form.reportValidity();
        clearInputs();
        if (status)
          status.textContent = 'Authorization incomplete. All controls must be confirmed.';
        return;
      }

      if (getValue(TIRN_SESSION_STORAGE_KEY) !== 'accepted') {
        clearInputs();
        if (status)
          status.textContent = 'Base staff session not established. Authorization denied.';
        return;
      }

      if (requiredLevel !== 'TL-3' || hasAdditionalControl) {
        clearInputs();
        if (status) {
          status.textContent =
            'The available credential does not satisfy this level, program, or compartment.';
        }
        return;
      }

      const grant = await verifyAuthorizationCredential(inputValue, Date.now());
      clearInputs();
      if (!grant) {
        if (status)
          status.textContent = 'Authorization not recognized. No access state was changed.';
        return;
      }

      try {
        sessionStorage.setItem(TIRN_GRANT_STORAGE_KEY, serializeElevatedGrant(grant));
      } catch {
        if (status) status.textContent = 'Session storage unavailable. Authorization not retained.';
        return;
      }

      if (status) status.textContent = 'TL-3 temporary authorization accepted for 15 minutes.';
      updateTrigger();
      dialog?.close();
      window.dispatchEvent(new CustomEvent(TIRN_ACCESS_CHANGE_EVENT));
    });

    window.addEventListener(TIRN_ACCESS_CHANGE_EVENT, updateTrigger);
    window.setInterval(() => {
      const grant = parseElevatedGrant(getValue(TIRN_GRANT_STORAGE_KEY), Date.now());
      if (!grant) updateTrigger();
    }, 1000);
  };

  document
    .querySelectorAll<HTMLElement>('[data-authorization-control]')
    .forEach(initializeAuthorizationControl);
</script>

<style>
  .authorization-control {
    display: inline-flex;
  }

  .authorization-trigger,
  .authorization-submit,
  .authorization-dialog__heading button {
    min-height: 2.65rem;
    border: 1px solid #315b86;
    border-radius: 0;
    padding: 0.65rem 0.9rem;
    background: #fff;
    color: #123f6c;
    font: 600 0.67rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.045em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .authorization-trigger:hover,
  .authorization-submit:hover,
  .authorization-dialog__heading button:hover {
    background: #e6eef6;
  }

  .authorization-trigger:disabled {
    color: #64717d;
    cursor: not-allowed;
  }

  .authorization-dialog {
    width: min(calc(100% - 2rem), 39rem);
    max-height: min(90svh, 48rem);
    overflow: auto;
    border: 1px solid #142b43;
    border-radius: 0;
    padding: 0;
    background: #f5f6f7;
    color: #17212b;
    box-shadow: 0 1.2rem 3.5rem rgba(4, 15, 27, 0.36);
  }

  .authorization-dialog::backdrop {
    background: rgba(5, 14, 24, 0.72);
  }

  .authorization-dialog__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.2rem;
    background: #10243b;
    color: #fff;
  }

  .authorization-dialog__heading p,
  .authorization-dialog__heading h2 {
    margin: 0;
  }

  .authorization-dialog__heading p {
    margin-bottom: 0.2rem;
    color: #afc2d5;
    font: 500 0.59rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .authorization-dialog__heading h2 {
    color: inherit;
    font-size: 1rem;
    font-weight: 600;
  }

  .authorization-dialog__heading button {
    min-height: 2.25rem;
    border-color: #7990a9;
    background: transparent;
    color: #fff;
  }

  .authorization-dialog__body {
    padding: 1.2rem;
  }

  .authorization-dialog dl {
    margin: 0;
    border-top: 1px solid #8d99a5;
  }

  .authorization-dialog dl div {
    display: grid;
    grid-template-columns: minmax(9rem, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid #ccd1d6;
  }

  .authorization-dialog dt {
    color: #596673;
    font: 500 0.62rem/1.3 var(--font-mono, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .authorization-dialog dd {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .authorization-dialog__notice,
  .authorization-dialog__privacy,
  .authorization-dialog__status {
    font-size: 0.77rem;
  }

  .authorization-dialog__notice {
    margin: 1rem 0;
    border-left: 3px solid #2d628f;
    padding: 0.7rem 0.8rem;
    background: #e9eff5;
  }

  .authorization-dialog fieldset {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .authorization-dialog label:not(.authorization-dialog__attestation) {
    display: grid;
    gap: 0.35rem;
    color: #45515d;
    font: 600 0.63rem/1.3 var(--font-mono, monospace);
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .authorization-dialog input[type='password'],
  .authorization-dialog select {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid #7f8a95;
    border-radius: 0;
    padding: 0.65rem;
    background: #fff;
    color: #101820;
    font: 400 0.85rem/1.3 var(--font-sans, sans-serif);
  }

  .authorization-dialog__attestation {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
    color: #33404d;
    font-size: 0.78rem;
  }

  .authorization-dialog__attestation input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0.12rem 0 0;
  }

  .authorization-submit {
    justify-self: start;
    background: #174f87;
    color: #fff;
  }

  .authorization-dialog__status {
    min-height: 1.3rem;
    margin: 1rem 0 0;
    color: #153f68;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
  }

  .authorization-dialog__privacy {
    margin: 0.55rem 0 0;
    color: #66717c;
  }

  @media (max-width: 35rem) {
    .authorization-dialog__heading {
      align-items: flex-start;
    }

    .authorization-dialog dl div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .authorization-dialog[open] {
      animation: authorization-enter 140ms ease-out both;
    }

    @keyframes authorization-enter {
      from {
        opacity: 0;
        transform: translateY(0.5rem);
      }
    }
  }

  @media print {
    .authorization-control,
    .authorization-dialog {
      display: none !important;
    }
  }
</style>
