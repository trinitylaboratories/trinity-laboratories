---
import {
  CONTROL_OFFICE_REFERENCE_EXAMPLE,
  isTemporaryGrantLevel,
  type TirnLevel,
} from '../../lib/tirn-access';

interface Props {
  id: string;
  requiredLevel?: TirnLevel;
  program?: string;
  compartment?: string;
  triggerLabel?: string;
}

const {
  id,
  requiredLevel = 'TL-3',
  program,
  compartment,
  triggerLabel = 'Request access',
} = Astro.props;
const requestAvailable = isTemporaryGrantLevel(requiredLevel) && !program && !compartment;
const requiresControlOfficeReference = requiredLevel === 'TL-4';
const authorizationReferenceExample = `${requiredLevel.replace('-', '')}-ABC123`;
const dialogId = `${id}-authorization-dialog`;
const dialogTitleId = `${id}-authorization-title`;
const dialogDescriptionId = `${id}-authorization-description`;
const referenceHelpId = `${id}-authorization-reference-help`;
const controlOfficeHelpId = `${id}-control-office-reference-help`;
---

<div
  class="authorization-control"
  data-authorization-control
  data-required-level={requiredLevel}
  data-program={program}
  data-compartment={compartment}
  data-request-available={String(requestAvailable)}
  data-trigger-label={triggerLabel}
>
  <button
    class="authorization-trigger"
    type="button"
    data-authorize-trigger
    aria-haspopup="dialog"
    aria-controls={dialogId}
    disabled
  >
    {requestAvailable ? triggerLabel : 'Review access requirements'}
  </button>

  <dialog
    class="authorization-dialog"
    id={dialogId}
    data-authorization-dialog
    aria-labelledby={dialogTitleId}
    aria-describedby={dialogDescriptionId}
  >
    <div class="authorization-dialog__heading">
      <div>
        <p>Access control / information request</p>
        <h2 id={dialogTitleId}>Request controlled information access</h2>
      </div>
      <button type="button" data-authorization-close aria-label="Close authorization console">
        Close
      </button>
    </div>

    <div class="authorization-dialog__body">
      <dl>
        <div><dt>Required eligibility</dt><dd>{requiredLevel}</dd></div>
        <div><dt>Program</dt><dd>{program ?? 'Not specified'}</dd></div>
        <div><dt>Compartment</dt><dd>{compartment ?? 'Not specified'}</dd></div>
        <div>
          <dt>Control-office confirmation</dt>
          <dd>{requiresControlOfficeReference ? 'Required' : 'Not required'}</dd>
        </div>
        <div><dt>Grant duration</dt><dd>15 minutes</dd></div>
      </dl>

      <p class="authorization-dialog__notice" id={dialogDescriptionId}>
        {
          requestAvailable
            ? 'Eligibility does not establish need-to-know. State the working purpose and enter the authorization reference assigned to this review.'
            : 'This record requires a level, program, or compartment authorization that cannot be established from this terminal.'
        }
      </p>

      {
        requestAvailable && (
          <form data-authorization-form novalidate autocomplete="off">
            <fieldset disabled data-authorization-fields>
              <label>
                Working purpose
                <select data-authorization-purpose required autocomplete="off">
                  <option value="">Select a purpose</option>
                  <option value="record-review">Record review</option>
                  <option value="required-training">Required training</option>
                  <option value="records-administration">Records administration</option>
                </select>
              </label>

              <label>
                Authorization reference
                <input
                  type="text"
                  data-authorization-reference
                  required
                  minlength="10"
                  maxlength="16"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  placeholder={authorizationReferenceExample}
                  aria-describedby={referenceHelpId}
                />
                <span class="authorization-dialog__field-help" id={referenceHelpId}>
                  Enter the assigned {requiredLevel} reference in the{' '}
                  {requiredLevel.replace('-', '')}-XXXXXX format. Employee terminal codes are not
                  valid here.
                </span>
              </label>

              {requiresControlOfficeReference && (
                <label>
                  Control-office reference
                  <input
                    type="text"
                    data-control-office-reference
                    required
                    minlength="9"
                    maxlength="15"
                    autocomplete="off"
                    autocapitalize="characters"
                    spellcheck="false"
                    placeholder={CONTROL_OFFICE_REFERENCE_EXAMPLE}
                    aria-describedby={controlOfficeHelpId}
                  />
                  <span class="authorization-dialog__field-help" id={controlOfficeHelpId}>
                    TL-4 requests require an independent CO-XXXXXX release reference.
                  </span>
                </label>
              )}

              <label class="authorization-dialog__attestation">
                <input type="checkbox" data-authorization-attestation required />
                <span>
                  I attest that the requested information is required for the stated purpose.
                </span>
              </label>

              <button class="authorization-submit" type="submit">
                Evaluate request
              </button>
            </fieldset>
          </form>
        )
      }

      <p class="authorization-dialog__status" role="status" aria-live="polite" data-auth-status>
        Access-request console initialization required.
      </p>
      <p class="authorization-dialog__privacy">
        Reference and purpose values are cleared after evaluation and are not transmitted or
        retained. Only the temporary level, scope, and expiry are kept for this session.
      </p>
    </div>
  </dialog>
</div>

<script>
  import {
    accessAllows,
    evaluateAuthorizationRequest,
    parseElevatedGrant,
    resolveTirnAccess,
    serializeElevatedGrant,
    TIRN_ACCESS_CHANGE_EVENT,
    TIRN_GRANT_STORAGE_KEY,
    TIRN_SESSION_STORAGE_KEY,
    type TirnLevel,
  } from '../../lib/tirn-access';

  const initializeAuthorizationControl = (root: HTMLElement) => {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const trigger = root.querySelector<HTMLButtonElement>('[data-authorize-trigger]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-authorization-dialog]');
    const close = root.querySelector<HTMLButtonElement>('[data-authorization-close]');
    const form = root.querySelector<HTMLFormElement>('[data-authorization-form]');
    const fields = root.querySelector<HTMLFieldSetElement>('[data-authorization-fields]');
    const purpose = root.querySelector<HTMLSelectElement>('[data-authorization-purpose]');
    const authorizationReference = root.querySelector<HTMLInputElement>(
      '[data-authorization-reference]',
    );
    const controlOfficeReference = root.querySelector<HTMLInputElement>(
      '[data-control-office-reference]',
    );
    const attestation = root.querySelector<HTMLInputElement>('[data-authorization-attestation]');
    const status = root.querySelector<HTMLElement>('[data-auth-status]');
    const requiredLevel = (root.dataset.requiredLevel || 'TL-3') as TirnLevel;
    const hasAdditionalControl = Boolean(root.dataset.program || root.dataset.compartment);
    const requestAvailable = root.dataset.requestAvailable === 'true';

    const getValue = (key: string) => {
      try {
        return sessionStorage.getItem(key);
      } catch {
        return null;
      }
    };

    const clearInvalidState = () => {
      for (const control of [
        purpose,
        authorizationReference,
        controlOfficeReference,
        attestation,
      ]) {
        control?.removeAttribute('aria-invalid');
      }
    };

    const clearInputs = () => {
      if (authorizationReference) authorizationReference.value = '';
      if (controlOfficeReference) controlOfficeReference.value = '';
      if (purpose) purpose.value = '';
      if (attestation) attestation.checked = false;
      clearInvalidState();
    };

    const currentAccessAllows = () => {
      const now = Date.now();
      const state = resolveTirnAccess(
        getValue(TIRN_SESSION_STORAGE_KEY),
        getValue(TIRN_GRANT_STORAGE_KEY),
        now,
      );
      return !hasAdditionalControl && accessAllows(state, requiredLevel);
    };

    const updateTrigger = () => {
      if (!trigger) return;
      trigger.textContent = currentAccessAllows()
        ? 'Access active'
        : requestAvailable
          ? (root.dataset.triggerLabel ?? 'Request access')
          : 'Review access requirements';
    };

    if (trigger && status) {
      trigger.disabled = false;
      if (fields) fields.disabled = false;
      status.textContent = requestAvailable
        ? 'Console ready. Request values are required.'
        : 'Separate authorization is required. No local request is available.';
      updateTrigger();
    }

    trigger?.addEventListener('click', () => {
      if (!dialog) return;
      clearInputs();
      if (status) {
        status.textContent = currentAccessAllows()
          ? 'A qualifying temporary access grant is already active.'
          : requestAvailable
            ? 'Console ready. Request values are required.'
            : 'Separate authorization is required. No local request is available.';
      }
      dialog.showModal();
      (requestAvailable ? purpose : close)?.focus();
    });

    const closeDialog = () => {
      clearInputs();
      dialog?.close();
      trigger?.focus();
    };

    close?.addEventListener('click', closeDialog);
    dialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeDialog();
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      clearInvalidState();

      if (getValue(TIRN_SESSION_STORAGE_KEY) !== 'accepted') {
        clearInputs();
        if (status) status.textContent = 'Base staff session not established. Request denied.';
        return;
      }

      if (!requestAvailable || hasAdditionalControl) {
        clearInputs();
        if (status) {
          status.textContent =
            'This level, program, or compartment requires separate authorization.';
        }
        return;
      }

      const result = evaluateAuthorizationRequest(
        {
          requiredLevel,
          purpose: purpose?.value ?? '',
          authorizationReference: authorizationReference?.value ?? '',
          controlOfficeReference: controlOfficeReference?.value,
          attested: Boolean(attestation?.checked),
        },
        Date.now(),
      );

      if (!result.accepted) {
        const control =
          result.field === 'purpose'
            ? purpose
            : result.field === 'authorizationReference'
              ? authorizationReference
              : result.field === 'controlOfficeReference'
                ? controlOfficeReference
                : result.field === 'attestation'
                  ? attestation
                  : undefined;
        control?.setAttribute('aria-invalid', 'true');
        control?.focus();
        if (status) status.textContent = result.message;
        return;
      }

      clearInputs();

      try {
        sessionStorage.setItem(TIRN_GRANT_STORAGE_KEY, serializeElevatedGrant(result.grant));
      } catch {
        if (status) status.textContent = 'Session storage unavailable. Access was not retained.';
        return;
      }

      if (status)
        status.textContent = `${result.grant.level} temporary access accepted for 15 minutes.`;
      updateTrigger();
      dialog?.close();
      window.dispatchEvent(new CustomEvent(TIRN_ACCESS_CHANGE_EVENT));
    });

    window.addEventListener(TIRN_ACCESS_CHANGE_EVENT, updateTrigger);
    window.setInterval(() => {
      const grant = parseElevatedGrant(getValue(TIRN_GRANT_STORAGE_KEY), Date.now());
      if (!grant) updateTrigger();
    }, 1000);
  };

  document
    .querySelectorAll<HTMLElement>('[data-authorization-control]')
    .forEach(initializeAuthorizationControl);
</script>

<style>
  .authorization-control {
    display: inline-flex;
  }

  .authorization-trigger,
  .authorization-submit,
  .authorization-dialog__heading button {
    min-height: 2.65rem;
    border: 1px solid #315b86;
    border-radius: 0;
    padding: 0.65rem 0.9rem;
    background: #fff;
    color: #123f6c;
    font: 600 0.67rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.045em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .authorization-trigger:hover,
  .authorization-submit:hover,
  .authorization-dialog__heading button:hover {
    background: #e6eef6;
  }

  .authorization-trigger:disabled {
    color: #64717d;
    cursor: not-allowed;
  }

  .authorization-dialog {
    width: min(calc(100% - 2rem), 39rem);
    max-height: min(90svh, 48rem);
    overflow: auto;
    border: 1px solid #142b43;
    border-radius: 0;
    padding: 0;
    background: #f5f6f7;
    color: #17212b;
    box-shadow: 0 1.2rem 3.5rem rgba(4, 15, 27, 0.36);
  }

  .authorization-dialog::backdrop {
    background: rgba(5, 14, 24, 0.72);
  }

  .authorization-dialog__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.2rem;
    background: #10243b;
    color: #fff;
  }

  .authorization-dialog__heading p,
  .authorization-dialog__heading h2 {
    margin: 0;
  }

  .authorization-dialog__heading p {
    margin-bottom: 0.2rem;
    color: #afc2d5;
    font: 500 0.59rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .authorization-dialog__heading h2 {
    color: inherit;
    font-size: 1rem;
    font-weight: 600;
  }

  .authorization-dialog__heading button {
    min-height: 2.25rem;
    border-color: #7990a9;
    background: transparent;
    color: #fff;
  }

  .authorization-dialog__body {
    padding: 1.2rem;
  }

  .authorization-dialog dl {
    margin: 0;
    border-top: 1px solid #8d99a5;
  }

  .authorization-dialog dl div {
    display: grid;
    grid-template-columns: minmax(9rem, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid #ccd1d6;
  }

  .authorization-dialog dt {
    color: #596673;
    font: 500 0.62rem/1.3 var(--font-mono, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .authorization-dialog dd {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .authorization-dialog__notice,
  .authorization-dialog__privacy,
  .authorization-dialog__status {
    font-size: 0.77rem;
  }

  .authorization-dialog__notice {
    margin: 1rem 0;
    border-left: 3px solid #2d628f;
    padding: 0.7rem 0.8rem;
    background: #e9eff5;
  }

  .authorization-dialog fieldset {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .authorization-dialog label:not(.authorization-dialog__attestation) {
    display: grid;
    gap: 0.35rem;
    color: #45515d;
    font: 600 0.63rem/1.3 var(--font-mono, monospace);
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .authorization-dialog input[type='text'],
  .authorization-dialog select {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid #7f8a95;
    border-radius: 0;
    padding: 0.65rem;
    background: #fff;
    color: #101820;
    font: 400 0.85rem/1.3 var(--font-sans, sans-serif);
  }

  .authorization-dialog input[aria-invalid='true'],
  .authorization-dialog select[aria-invalid='true'] {
    border-color: #8d252c;
    box-shadow: inset 0 0 0 1px #8d252c;
  }

  .authorization-dialog__attestation input[aria-invalid='true'] {
    outline: 2px solid #8d252c;
    outline-offset: 2px;
  }

  .authorization-dialog__attestation {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
    color: #33404d;
    font-size: 0.78rem;
  }

  .authorization-dialog__field-help {
    color: #66717c;
    font: 400 0.7rem/1.45 var(--font-sans, sans-serif);
    letter-spacing: normal;
    text-transform: none;
  }

  .authorization-dialog__attestation input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0.12rem 0 0;
  }

  .authorization-submit {
    justify-self: start;
    background: #174f87;
    color: #fff;
  }

  .authorization-dialog__status {
    min-height: 1.3rem;
    margin: 1rem 0 0;
    color: #153f68;
    font-family: var(--font-mono, monospace);
    font-weight: 600;
  }

  .authorization-dialog__privacy {
    margin: 0.55rem 0 0;
    color: #66717c;
  }

  @media (max-width: 35rem) {
    .authorization-dialog__heading {
      align-items: flex-start;
    }

    .authorization-dialog dl div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .authorization-dialog[open] {
      animation: authorization-enter 140ms ease-out both;
    }

    @keyframes authorization-enter {
      from {
        opacity: 0;
        transform: translateY(0.5rem);
      }
    }
  }

  @media print {
    .authorization-control,
    .authorization-dialog {
      display: none !important;
    }
  }
</style>
