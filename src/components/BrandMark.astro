---
interface Props {
  inverse?: boolean;
  compact?: boolean;
}

const { inverse = false, compact = false } = Astro.props;
const variant = compact ? 'wordmark' : 'full';
const image = compact
  ? {
      src: '/media/brand/trinity-wordmark.png',
      width: 1731,
      height: 909,
    }
  : {
      src: '/media/brand/trinity-full.png',
      width: 2048,
      height: 768,
    };
---

<a
  class:list={['brand-mark', { 'brand-mark--inverse': inverse, 'brand-mark--compact': compact }]}
  href="/"
  aria-label="Trinity Laboratories home"
>
  <span class="brand-mark__asset" data-brand-asset={variant} aria-hidden="true">
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      alt=""
      loading={inverse ? 'lazy' : 'eager'}
      decoding="async"
    />
  </span>
</a>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    text-decoration: none;
    min-width: 0;
  }

  .brand-mark--inverse {
    padding: 0.38rem 0.55rem;
    background: #f3f1ea;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }

  .brand-mark__asset {
    display: block;
    width: clamp(11rem, 22vw, 16rem);
    aspect-ratio: 4 / 1;
    overflow: hidden;
  }

  .brand-mark__asset img {
    display: block;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .brand-mark--compact .brand-mark__asset {
    width: clamp(9.5rem, 18vw, 13rem);
    aspect-ratio: 4.2 / 1;
  }

  .brand-mark--compact .brand-mark__asset img {
    object-position: 50% 53.5%;
  }
</style>
