---
import BrandMark from './BrandMark.astro';
---

<footer class="site-footer">
  <div class="site-footer__lead">
    <BrandMark inverse />
    <p>Applied research, testing, and technical support for laboratory and field work.</p>
  </div>
  <div class="site-footer__links">
    <div>
      <strong>Institution</strong>
      <a href="/about/">About</a>
      <a href="/research/">Research</a>
      <a href="/studies/">Participant Studies</a>
      <a href="/facilities/">Facilities</a>
    </div>
    <div>
      <strong>Information</strong>
      <a href="/publications/">Publications</a>
      <a href="/careers/">Careers</a>
      <a href="/contact/">Contact</a>
    </div>
    <div>
      <strong>Staff</strong>
      <a href="/employee-access/">Employee Access</a>
    </div>
  </div>
  <div class="site-footer__base">
    <span>© 2026 Trinity Laboratories contributors</span>
    <span>Research • Testing • Field services</span>
  </div>
  <p class="builder-credit">
    Built with ❤️ by{' '}
    <a
      href="https://jpowersfreelancing.com/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="JPowersFreelancing (opens in a new tab)">JPowersFreelancing</a
    >
  </p>
</footer>

<style>
  .builder-credit {
    grid-column: 1 / -1;
    margin: 1.5rem 0 0;
    text-align: right;
    font-size: 0.875rem;
    line-height: 1.6;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
  }
  .builder-credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
