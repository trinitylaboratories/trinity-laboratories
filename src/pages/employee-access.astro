---
import CorporateLayout from '../layouts/CorporateLayout.astro';
---

<CorporateLayout
  title="Employee Access"
  description="Trinity Laboratories staff systems access terminal."
  class="access-page"
>
  <section class="access-shell">
    <div class="access-shell__identity">
      <p class="eyebrow">Institutional systems</p>
      <h1>STAFF</h1>
      <p>Trinity Laboratories Institutional Systems</p>
      <dl>
        <div><dt>Node</dt><dd>Employee Services Gateway</dd></div>
        <div><dt>Condition</dt><dd>WHITE</dd></div>
        <div><dt>Interface</dt><dd>Available</dd></div>
      </dl>
    </div>
    <div class="terminal">
      <div class="terminal__bar"><span>ACCESS CONTROL</span><span>TL-NET / 01</span></div>
      <form data-gateway-form novalidate autocomplete="off">
        <fieldset disabled data-gateway-fields>
          <label for="badge-id"
            >Badge identifier
            <input
              id="badge-id"
              type="text"
              required
              minlength="3"
              maxlength="32"
              pattern="[A-Za-z0-9-]+"
              autocomplete="off"
              spellcheck="false"
            />
          </label>
          <div class="terminal__code-control">
            <button class="button" type="button" data-generate-code>Issue terminal code</button>
            <output data-terminal-code aria-live="polite">------</output>
            <small data-code-expiry>Awaiting issue</small>
          </div>
          <label for="terminal-code"
            >One-time terminal code
            <input
              id="terminal-code"
              type="text"
              required
              minlength="6"
              maxlength="6"
              pattern="[A-Za-z0-9]{6}"
              autocomplete="off"
              spellcheck="false"
              inputmode="text"
            />
          </label>
          <button class="button button--primary" type="submit">Establish session</button>
        </fieldset>
        <p class="terminal__status" role="status" aria-live="polite" data-gateway-status>
          Terminal initialization required.
        </p>
      </form>
    </div>
  </section>
</CorporateLayout>

<script>
  import {
    issueTerminalCode,
    terminalCodeMatches,
    terminalCodeRemainingMs,
    type IssuedTerminalCode,
  } from '../lib/local-protocol';

  const form = document.querySelector<HTMLFormElement>('[data-gateway-form]');
  const fields = form?.querySelector<HTMLFieldSetElement>('[data-gateway-fields]');
  const generate = form?.querySelector<HTMLButtonElement>('[data-generate-code]');
  const output = form?.querySelector<HTMLOutputElement>('[data-terminal-code]');
  const expiry = form?.querySelector<HTMLElement>('[data-code-expiry]');
  const badge = form?.querySelector<HTMLInputElement>('#badge-id');
  const codeInput = form?.querySelector<HTMLInputElement>('#terminal-code');
  const status = form?.querySelector<HTMLElement>('[data-gateway-status]');

  let issuedCode: IssuedTerminalCode = { code: '', expiresAt: 0 };
  let expiryTimer = 0;

  const clearCode = (message = 'Awaiting issue') => {
    issuedCode = { code: '', expiresAt: 0 };
    if (output) output.textContent = '------';
    if (expiry) expiry.textContent = message;
    if (codeInput) codeInput.value = '';
    window.clearInterval(expiryTimer);
  };

  const updateExpiry = () => {
    const remaining = terminalCodeRemainingMs(issuedCode.expiresAt, Date.now());
    if (!remaining) {
      clearCode('Code expired');
      if (status) status.textContent = 'Terminal code expired. Issue a new code.';
      return;
    }
    if (expiry) expiry.textContent = `Expires in ${Math.ceil(remaining / 1000)} seconds`;
  };

  if (fields && status) {
    fields.disabled = false;
    status.textContent = 'Terminal ready. Issue a local code to continue.';
  }

  generate?.addEventListener('click', () => {
    const bytes = new Uint32Array(6);
    crypto.getRandomValues(bytes);
    issuedCode = issueTerminalCode(bytes, Date.now());
    if (output) output.textContent = issuedCode.code;
    if (status) status.textContent = 'One-time terminal code issued.';
    window.clearInterval(expiryTimer);
    expiryTimer = window.setInterval(updateExpiry, 1000);
    updateExpiry();
    codeInput?.focus();
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      if (status) status.textContent = 'Access sequence incomplete.';
      return;
    }
    if (terminalCodeRemainingMs(issuedCode.expiresAt, Date.now()) === 0) {
      clearCode('Code expired');
      if (status) status.textContent = 'Terminal code expired. Issue a new code.';
      return;
    }
    if (!terminalCodeMatches(codeInput?.value ?? '', issuedCode, Date.now())) {
      if (status) status.textContent = 'Terminal code not recognized.';
      if (codeInput) codeInput.value = '';
      return;
    }

    if (badge) badge.value = '';
    if (codeInput) codeInput.value = '';
    clearCode('Session established');
    try {
      sessionStorage.setItem('tirn-session', 'accepted');
    } catch {
      // Storage is only a cosmetic session indicator; records remain public.
    }
    if (status) status.textContent = 'SESSION ACCEPTED. OPENING STAFF SERVICES.';
    window.setTimeout(() => window.location.assign('/portal/'), 180);
  });
</script>

<style>
  :global(.access-page .site-header),
  :global(.access-page .site-footer) {
    display: none;
  }

  .access-shell {
    display: grid;
    grid-template-columns: minmax(18rem, 0.75fr) minmax(24rem, 1.25fr);
    min-height: 100svh;
    background: #06101c;
    color: #ecf3fb;
  }

  .access-shell__identity,
  .terminal {
    padding: clamp(2rem, 7vw, 7rem);
  }

  .access-shell__identity {
    position: relative;
    display: flex;
    overflow: hidden;
    flex-direction: column;
    justify-content: flex-end;
    background: #0a3a78;
  }

  .access-shell__identity::before {
    position: absolute;
    top: 8%;
    right: -25%;
    width: 80%;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(15, 99, 218, 0.28);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    content: '';
  }

  .access-shell__identity h1 {
    margin: 0;
    font-size: clamp(6rem, 14vw, 13rem);
    font-weight: 500;
    letter-spacing: -0.08em;
    line-height: 0.78;
  }

  .access-shell__identity > p:not(.eyebrow) {
    max-width: 22rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .access-shell dl {
    margin: 3rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.45);
  }

  .access-shell dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    font: 400 0.68rem/1.3 var(--font-mono);
    text-transform: uppercase;
  }

  .terminal {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-image:
      linear-gradient(rgba(39, 81, 124, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(39, 81, 124, 0.16) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
  }

  .terminal__bar {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 0;
    border-block: 1px solid #3a5875;
    color: #87a9cd;
    font: 400 0.68rem/1.2 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .terminal form {
    margin-top: 2.4rem;
  }
  .terminal fieldset {
    display: grid;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .terminal label {
    display: grid;
    gap: 0.5rem;
    color: #9fb2c7;
    font: 400 0.7rem/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .terminal input {
    border-color: #476682;
    background: #091a2b;
    color: #fff;
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
  }
  .terminal__code-control {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem 1rem;
    align-items: center;
  }
  .terminal__code-control output {
    color: #74a8ff;
    font: 500 2rem/1 var(--font-mono);
    letter-spacing: 0.18em;
    text-align: right;
  }
  .terminal__code-control small {
    grid-column: 1 / -1;
    color: #71869b;
    font-family: var(--font-mono);
    text-align: right;
    text-transform: uppercase;
  }
  .terminal__status {
    min-height: 1.5rem;
    margin: 1.5rem 0 0;
    color: #85a5c7;
    font: 400 0.72rem/1.4 var(--font-mono);
    text-transform: uppercase;
  }

  @media (max-width: 50rem) {
    .access-shell {
      grid-template-columns: 1fr;
    }
    .access-shell__identity {
      min-height: 42svh;
    }
  }
</style>
