---
import { getCollection, type CollectionEntry } from 'astro:content';

import StudyInterestForm from '../../components/studies/StudyInterestForm.astro';
import StudyProtocol from '../../components/studies/StudyProtocol.astro';
import CorporateLayout from '../../layouts/CorporateLayout.astro';
import { studyStatusLabel, type StudyData } from '../../lib/study-schema';
import '../../styles/studies.css';

export async function getStaticPaths() {
  const studies = await getCollection('studies');
  return studies.map((entry: CollectionEntry<'studies'>) => ({
    params: { slug: entry.data.slug },
    props: { study: entry.data as StudyData },
  }));
}

interface Props {
  study: StudyData;
}

const { study } = Astro.props;
const description = (() => {
  if (study.summary.length <= 178) return study.summary;
  const shortened = study.summary.slice(0, 175).replace(/\s+\S*$/, '');
  return `${shortened}…`;
})();
const participationMessage = {
  active: 'This study is underway and is not accepting additional participants.',
  paused: 'Participation is paused while we review the study materials.',
  completed: 'This study has concluded and is no longer accepting participants.',
  recruiting: '',
  'interest-only': '',
}[study.status];
---

<CorporateLayout title={study.shortTitle} description={description} active="studies">
  <section class="study-hero" data-study-status={study.status}>
    <div class="study-hero__grid" aria-hidden="true"></div>
    <div class="study-hero__main">
      <p class="eyebrow">Participant study / {study.studyId}</p>
      <h1>{study.title}</h1>
      <p class="study-hero__question">{study.researchQuestion}</p>
      <div class="button-row">
        {
          study.application ? (
            <a class="button button--primary" href="#participation-screen">
              Check eligibility
            </a>
          ) : (
            <a class="button button--primary" href="#study-method">
              Review study method
            </a>
          )
        }
        <a class="button" href="/studies/">All studies</a>
      </div>
    </div>
    <aside class="study-hero__meta" aria-label="Study details">
      <span class="study-status" data-status={study.status}>{studyStatusLabel(study.status)}</span>
      <dl>
        <div><dt>Protocol</dt><dd>{study.studyId} / Rev. {study.protocolRevision}</dd></div>
        <div><dt>Phase</dt><dd>{study.phase}</dd></div>
        <div><dt>Method</dt><dd>{study.studyType}</dd></div>
        <div><dt>Mode</dt><dd>{study.participationMode}</dd></div>
        <div><dt>Commitment</dt><dd>{study.commitment}</dd></div>
        <div><dt>Office</dt><dd>{study.controllingOffice}</dd></div>
      </dl>
    </aside>
    <div class="study-hero__trace" aria-hidden="true">
      <i></i><span>01</span><i></i><span>02</span><i></i><span>03</span><i></i><span>04</span><i
      ></i>
    </div>
  </section>

  <section class="section study-overview" data-reveal>
    <div class="section__heading">
      <p class="section-label">Study overview</p>
      <h2>What the study involves.</h2>
      <p>{study.summary}</p>
    </div>
    <div class="study-two-column">
      <div>
        <h3>What you’ll do</h3>
        <ol class="study-numbered-list">
          {study.participantActivities.map((activity) => <li>{activity}</li>)}
        </ol>
      </div>
      <div>
        <h3>Who can take part</h3>
        <ul class="study-plain-list">
          {study.eligibility.map((item) => <li>{item}</li>)}
        </ul>
        <h3>Not part of this study</h3>
        <ul class="study-plain-list study-plain-list--muted">
          {study.exclusions.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="study-method" data-reveal>
    <div class="section__heading">
      <p class="section-label">Study steps</p>
      <h2>How the study works.</h2>
      <p>
        Please follow the steps in order. If you miss an observation, leave it blank rather than
        trying to recreate it later.
      </p>
    </div>
    <StudyProtocol steps={study.protocolSteps} />
  </section>

  <section class="section study-data" data-reveal>
    <div class="section__heading">
      <p class="section-label">Information used</p>
      <h2>What we ask for.</h2>
      <p>We ask only for the broad categories and observations listed below.</p>
    </div>
    <div class="study-data__columns">
      <div>
        <h3>What we ask you to record</h3>
        <ul>{study.dataRequested.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h3>What we don’t ask for</h3>
        <ul>{study.dataNotRequested.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section study-prompts" data-reveal>
    <div class="study-prompts__heading">
      <p class="section-label">Sample questions</p>
      <h2>Examples of what you’ll be asked.</h2>
    </div>
    <ol>
      {
        study.samplePrompts.map((prompt, index) => (
          <li>
            <>
              <small>{String(index + 1).padStart(2, '0')}</small>
              <p>{prompt}</p>
            </>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section study-method-notes" data-reveal>
    <div>
      <p class="section-label">Method notes</p>
      <h2>Why the method is structured this way.</h2>
      <ul>{study.methodNotes.map((note) => <li>{note}</li>)}</ul>
    </div>
    <div>
      <p class="section-label">Limitations</p>
      <h2>What the results cannot show.</h2>
      <ul>{study.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
    </div>
  </section>

  {
    study.publicSummary && (
      <section class="section study-public-summary" data-reveal>
        <p class="section-label">Study summary</p>
        <h2>What this study established.</h2>
        <p>{study.publicSummary}</p>
      </section>
    )
  }

  {
    study.application ? (
      <div class="section" id="participation-screen" data-reveal>
        <StudyInterestForm studyId={study.studyId} application={study.application} />
      </div>
    ) : (
      <section class="section study-availability" data-reveal>
        <p class="section-label">Participation status</p>
        <h2>{studyStatusLabel(study.status)}</h2>
        <p>{participationMessage}</p>
        <div class="button-row">
          <a class="button" href="/studies/">
            Return to study register
          </a>
        </div>
      </section>
    )
  }
</CorporateLayout>
