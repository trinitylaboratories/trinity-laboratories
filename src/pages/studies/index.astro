---
import { getCollection, type CollectionEntry } from 'astro:content';

import StudyRegister from '../../components/studies/StudyRegister.astro';
import CorporateLayout from '../../layouts/CorporateLayout.astro';
import type { StudyData } from '../../lib/study-schema';
import '../../styles/studies.css';

const studies: StudyData[] = (await getCollection('studies'))
  .map((entry: CollectionEntry<'studies'>) => entry.data as StudyData)
  .sort((left: StudyData, right: StudyData) => left.displayOrder - right.displayOrder);
const screeningCount = studies.filter((study: StudyData) => study.application !== null).length;
---

<CorporateLayout
  title="Participant Studies"
  description="Current and selected completed observation studies from Trinity Laboratories."
  active="studies"
>
  <section class="studies-hero">
    <div class="studies-hero__grid" aria-hidden="true"></div>
    <div class="studies-hero__copy">
      <p class="eyebrow">Participant studies</p>
      <h1>Everyday questions, studied carefully.</h1>
      <p>
        Take part in focused, non-medical studies of everyday instruments, materials, environments,
        and observation methods.
      </p>
      <div class="button-row">
        <a class="button button--primary" href="#study-register">Browse current studies</a>
        <a class="button" href="#participation-method">How participation works</a>
      </div>
    </div>
    <div class="studies-hero__protocol" aria-label="Study sequence">
      <span>Observe</span><i aria-hidden="true"></i><span>Record</span><i aria-hidden="true"
      ></i><span>Compare</span><i aria-hidden="true"></i><span>Review</span>
    </div>
    <div class="studies-hero__register">
      <span>{String(studies.length).padStart(2, '0')} studies</span>
      <span>{String(screeningCount).padStart(2, '0')} open eligibility checks</span>
      <span>Current study register</span>
    </div>
  </section>

  <section class="section" id="study-register" data-reveal>
    <div class="section__heading">
      <p class="section-label">Current register</p>
      <h2>Find a study that fits.</h2>
      <p>
        Each listing explains what the study asks, who can take part, what you’ll do, and how much
        time it takes before you complete a brief eligibility check.
      </p>
    </div>
    <StudyRegister studies={studies} />
  </section>

  <section class="section section--dark" id="participation-method" data-reveal>
    <div class="section__heading">
      <p class="section-label">How participation works</p>
      <h2>What to expect when you take part.</h2>
      <p>
        Our public studies focus on limited, low-risk observations and ask only for information
        directly related to the study. We do not request health records, exact locations, photos,
        recordings, or device telemetry.
      </p>
    </div>
    <ol class="studies-method">
      <li>
        <small>01</small><strong>Read the study details</strong><span
          >Question, time, and eligibility</span
        >
      </li>
      <li>
        <small>02</small><strong>Check whether it fits</strong><span
          >Equipment, setting, and schedule</span
        >
      </li>
      <li>
        <small>03</small><strong>Follow the study steps</strong><span
          >Brief, defined observations</span
        >
      </li>
      <li>
        <small>04</small><strong>Complete the series</strong><span
          >Leave missed observations blank</span
        >
      </li>
    </ol>
  </section>

  <section class="section studies-closing" data-reveal>
    <p class="section-label">General questions</p>
    <h2>Not every study will be the right fit.</h2>
    <p>
      If the equipment, setting, or schedule doesn’t work for you, explore another study or check
      back later.
    </p>
    <div class="button-row">
      <a class="button button--primary" href="#study-register">Browse studies</a>
      <a class="button" href="/contact/">Ask a question</a>
    </div>
  </section>
</CorporateLayout>
