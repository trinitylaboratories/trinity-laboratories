---
import { getCollection, type CollectionEntry } from 'astro:content';

import StudyRegister from '../../components/studies/StudyRegister.astro';
import CorporateLayout from '../../layouts/CorporateLayout.astro';
import type { StudyData } from '../../lib/study-schema';
import '../../styles/studies.css';

const studies: StudyData[] = (await getCollection('studies'))
  .map((entry: CollectionEntry<'studies'>) => entry.data as StudyData)
  .sort((left: StudyData, right: StudyData) => left.displayOrder - right.displayOrder);
const screeningCount = studies.filter((study: StudyData) => study.application !== null).length;
---

<CorporateLayout
  title="Participant Studies"
  description="Current and selected completed observation studies from Trinity Laboratories."
  active="studies"
>
  <section class="studies-hero">
    <div class="studies-hero__grid" aria-hidden="true"></div>
    <div class="studies-hero__copy">
      <p class="eyebrow">Participant studies / public register</p>
      <h1>Observe ordinary systems carefully.</h1>
      <p>
        Structured, non-medical studies of everyday instruments, materials, environments, and
        observation methods.
      </p>
      <div class="button-row">
        <a class="button button--primary" href="#study-register">Review current studies</a>
        <a class="button" href="#participation-method">Participation method</a>
      </div>
    </div>
    <div class="studies-hero__protocol" aria-label="Study sequence">
      <span>Observe</span><i aria-hidden="true"></i><span>Record</span><i aria-hidden="true"
      ></i><span>Compare</span><i aria-hidden="true"></i><span>Review</span>
    </div>
    <div class="studies-hero__register">
      <span>{String(studies.length).padStart(2, '0')} listed protocols</span>
      <span>{String(screeningCount).padStart(2, '0')} participation screens</span>
      <span>Methods office / current register</span>
    </div>
  </section>

  <section class="section" id="study-register" data-reveal>
    <div class="section__heading">
      <p class="section-label">Current register</p>
      <h2>Studies by protocol status.</h2>
      <p>
        Each entry states the research question, participant commitment, basic eligibility, method,
        and limits before a participation screen is presented.
      </p>
    </div>
    <StudyRegister studies={studies} />
  </section>

  <section class="section section--dark" id="participation-method" data-reveal>
    <div class="section__heading">
      <p class="section-label">Participation method</p>
      <h2>A narrow question and a fixed observation sequence.</h2>
      <p>
        Public studies are intentionally limited in scope. They avoid medical interpretation,
        precise location data, personal records, photographs, recordings, and device telemetry.
      </p>
    </div>
    <ol class="studies-method">
      <li>
        <small>01</small><strong>Review the protocol</strong><span>Question, scope, and limits</span
        >
      </li>
      <li>
        <small>02</small><strong>Check eligibility</strong><span>Only listed conditions</span>
      </li>
      <li>
        <small>03</small><strong>Follow the sequence</strong><span>Fixed observation intervals</span
        >
      </li>
      <li>
        <small>04</small><strong>Close the series</strong><span
          >Missed intervals remain missing</span
        >
      </li>
    </ol>
  </section>

  <section class="section studies-closing" data-reveal>
    <p class="section-label">General questions</p>
    <h2>Participation begins with the study protocol.</h2>
    <p>
      If a protocol does not match the available equipment, setting, or schedule, choose another
      study or return when a later interval opens.
    </p>
    <div class="button-row">
      <a class="button button--primary" href="#study-register">Return to the register</a>
      <a class="button" href="/contact/">General inquiry</a>
    </div>
  </section>
</CorporateLayout>
