---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

import SubmissionIndex from '../../../components/records/SubmissionIndex.astro';

const submissions = await getCollection('submissions');
const effectiveYears = submissions
  .map((submission: CollectionEntry<'submissions'>) =>
    Number(submission.data.effectiveDate.slice(0, 4)),
  )
  .filter(Number.isFinite);
const earliestYear = Math.min(...effectiveYears);
const latestYear = Math.max(...effectiveYears);
const personnelCount = submissions.filter(
  (submission: CollectionEntry<'submissions'>) => submission.data.recordFamily === 'personnel',
).length;
const technicalCount = submissions.length - personnelCount;
---

<StarlightPage
  frontmatter={{
    title: 'Digitized Technical Reports Register',
    description:
      'Selected digitized technical and administrative reports available through the TIRN records node.',
    pagefind: true,
    head: [
      {
        tag: 'meta',
        attrs: { name: 'robots', content: 'noindex, nofollow, noarchive' },
      },
    ],
  }}
>
  <p>
    This register contains selected digitized technical and administrative records. It is a working
    access register rather than a complete inventory of physical holdings.
  </p>

  <dl class="register-summary" aria-label="Digitized holdings summary">
    <div><dt>Indexed records</dt><dd>{submissions.length}</dd></div>
    <div><dt>Technical reports</dt><dd>{technicalCount}</dd></div>
    <div><dt>Personnel files</dt><dd>{personnelCount}</dd></div>
    <div><dt>Coverage</dt><dd>{earliestYear}–{latestYear}</dd></div>
  </dl>

  <aside class="register-notice" aria-label="Access model">
    <strong>Catalog access is not report access.</strong>
    Information eligibility, need-to-know, physical authority, and endorsements are evaluated as independent
    controls.
  </aside>

  <SubmissionIndex submissions={submissions} />

  <p class="register-footnote">
    Availability reflects the current node, information eligibility, and archival conversion status.
  </p>
</StarlightPage>

<style>
  .register-notice {
    margin: 1.5rem 0 2rem;
    border-block: 1px solid #aeb2b4;
    padding: 1rem 0;
    color: #3b4651;
  }

  .register-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 1.5rem 0;
    border-block: 1px solid #aeb2b4;
  }

  .register-summary div {
    padding: 0.8rem;
  }

  .register-summary dt {
    color: #59636d;
    font: 600 0.62rem/1.3 var(--sl-font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .register-summary dd {
    margin: 0.2rem 0 0;
    color: #17283b;
    font-weight: 650;
  }

  .register-notice strong {
    display: block;
    margin-bottom: 0.2rem;
    color: #151b22;
  }

  .register-footnote {
    margin-top: 1.5rem;
    color: #59636d;
    font-size: 0.82rem;
  }

  @media (max-width: 42rem) {
    .register-summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
