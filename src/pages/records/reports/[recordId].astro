---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

import SubmissionRecord from '../../../components/records/SubmissionRecord.astro';
import type { SubmissionRecordData } from '../../../lib/submission-schema';

interface Props {
  submission: SubmissionRecordData;
}

export async function getStaticPaths() {
  const submissions = await getCollection('submissions');
  return submissions.map((submission: CollectionEntry<'submissions'>) => ({
    params: { recordId: submission.data.recordId.toLowerCase() },
    props: { submission: submission.data as SubmissionRecordData },
  }));
}

const { submission } = Astro.props;
const standardRank = Number(submission.information.level.replace('TL-', ''));
const elevated =
  Boolean(submission.information.program || submission.information.compartment) ||
  !Number.isFinite(standardRank) ||
  standardRank >= 3;
const documentTitle = elevated
  ? `${submission.recordId} — Controlled report`
  : `${submission.recordId} — ${submission.title}`;
const documentDescription = elevated
  ? 'Controlled TIRN report. Descriptive metadata requires the displayed information eligibility.'
  : submission.summary;
---

<StarlightPage
  frontmatter={{
    title: documentTitle,
    description: documentDescription,
    pagefind: !elevated && submission.publicationState !== 'withheld',
    head: [
      {
        tag: 'meta',
        attrs: { name: 'robots', content: 'noindex, nofollow, noarchive' },
      },
    ],
  }}
>
  <SubmissionRecord submission={submission} />
</StarlightPage>
