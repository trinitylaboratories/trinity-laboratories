---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import PageHero from '../components/PageHero.astro';

const capabilities = [
  [
    '01',
    'Advanced Materials',
    'We compare how materials behave under defined conditions, using methods tailored to the question and intended use.',
  ],
  [
    '02',
    'Industrial Instrumentation',
    'We develop and evaluate measurement systems, calibrated assemblies, and practical interfaces for reliable observation.',
  ],
  [
    '03',
    'Environmental Analysis',
    'We use structured sampling and analytical methods to study changing physical and environmental conditions.',
  ],
  [
    '04',
    'Applied Physics',
    'We investigate physical behavior through controlled experiments focused on measurable, repeatable effects.',
  ],
  [
    '05',
    'Field Sampling & Geological Research',
    'We plan and document field sampling, material handling, and geological observations from collection through review.',
  ],
  [
    '06',
    'Laboratory Safety Systems',
    'We develop practical safety procedures and controls that support consistent laboratory work.',
  ],
  [
    '07',
    'Prototype Evaluation',
    'We test early instruments, assemblies, and processes against clear performance criteria.',
  ],
  [
    '08',
    'Contract Research',
    'We develop focused studies around an agreed question, method, schedule, and reporting approach.',
  ],
];
---

<CorporateLayout
  title="Research"
  description="Eight connected applied research capabilities at Trinity Laboratories."
  active="research"
>
  <PageHero
    eyebrow="Research capabilities"
    title="Research designed around the question."
    intro="Some projects stay within one discipline; others combine laboratory testing, instrumentation, environmental analysis, and field methods."
    index="TL / RESEARCH"
  />

  <section class="section research-media" data-reveal>
    <MediaFrame
      src="/media/facilities/materials-inspection.webp"
      aspect="wide"
      alt="Materials arranged at an inspection station for comparative evaluation"
      focalPoint="52% 54%"
      caption="Comparative materials inspection and image-based evaluation."
      credit="Trinity Laboratories"
    />
  </section>

  <section class="section capability-index" data-reveal>
    <ol>
      {
        capabilities.map(([index, title, copy]) => (
          <li>
            <small>{index}</small>
            <h2>{title}</h2>
            <p>{copy}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section section--dark" data-reveal>
    <div class="section__heading">
      <p class="section-label">Program method</p>
      <h2>We choose methods to fit the question.</h2>
      <p>
        When a project crosses disciplines, collection, testing, analysis, and review follow one
        coordinated plan.
      </p>
    </div>
    <div class="button-row">
      <a class="button button--primary" href="/studies/">View participant studies</a>
      <a class="button" href="/contact/">Discuss a project</a>
    </div>
  </section>
</CorporateLayout>

<style>
  .capability-index ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .research-media {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .capability-index li {
    display: grid;
    grid-template-columns: 4rem minmax(16rem, 1fr) minmax(16rem, 0.8fr);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: baseline;
    padding: clamp(1.5rem, 3vw, 2.75rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .capability-index small {
    font-family: var(--font-mono);
  }

  .capability-index h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .capability-index p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 46rem) {
    .capability-index li {
      grid-template-columns: 2.5rem 1fr;
    }
    .capability-index p {
      grid-column: 2;
    }
  }
</style>
