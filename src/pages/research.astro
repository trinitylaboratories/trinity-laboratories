---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import PageHero from '../components/PageHero.astro';
import { CAPABILITIES } from '../lib/capabilities';
---

<CorporateLayout
  title="Research"
  description="Eight connected applied research capabilities at Trinity Laboratories."
  active="research"
>
  <PageHero
    eyebrow="Research and testing"
    title="What do you need to find out?"
    intro="Explore our research areas, the questions we investigate, and what each type of study can tell you."
    index="TL / RESEARCH"
  />

  <section class="section research-media" data-reveal>
    <MediaFrame
      src="/media/facilities/materials-inspection.webp"
      aspect="wide"
      alt="Materials arranged at an inspection station for comparative evaluation"
      focalPoint="52% 54%"
      caption="Comparative materials inspection and image-based evaluation."
      credit="Trinity Laboratories"
    />
  </section>

  <section class="section capability-index" data-reveal>
    <ol>
      {
        CAPABILITIES.map((capability) => (
          <li>
            <small>{capability.index}</small>
            <div>
              <h2>{capability.title}</h2>
              <a href={`/research/${capability.slug}/`}>Explore this area</a>
            </div>
            <p>{capability.summary}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section section--dark" data-reveal>
    <div class="section__heading">
      <p class="section-label">Planning your project</p>
      <h2>Let’s start with what you need to know.</h2>
      <p>We agree on the question, the test plan, and the reporting you need before work begins.</p>
    </div>
    <div class="button-row">
      <a class="button button--primary" href="/contact/">Discuss a project</a>
    </div>
  </section>
</CorporateLayout>

<style>
  .capability-index ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .research-media {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .capability-index li {
    display: grid;
    grid-template-columns: 4rem minmax(16rem, 1fr) minmax(16rem, 0.8fr);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: baseline;
    padding: clamp(1.5rem, 3vw, 2.75rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .capability-index small {
    font-family: var(--font-mono);
  }

  .capability-index h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .capability-index h2 + a {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }

  .capability-index p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 46rem) {
    .capability-index li {
      grid-template-columns: 2.5rem 1fr;
    }
    .capability-index p {
      grid-column: 2;
    }
  }
</style>
