---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import PageHero from '../components/PageHero.astro';
---

<CorporateLayout
  title="Facilities"
  description="Controlled laboratory, instrumentation, environmental, and field research environments."
  active="facilities"
>
  <PageHero
    eyebrow="Operating environments"
    title="Spaces organized around the integrity of the work."
    intro="Facility planning follows the movement of material, instruments, personnel, and records through a controlled research process."
    index="TL / FACILITIES"
  />

  <section class="section" data-reveal>
    <MediaFrame
      aspect="wide"
      alt="Reserved facility photography field"
      label="Facility photography pending"
      caption="Controlled research environment"
      credit="TL Media Registry"
    />
  </section>

  <section class="section" data-reveal>
    <div class="section__heading">
      <p class="section-label">Environment types</p>
      <h2>Capability follows the work.</h2>
      <p>
        Descriptions identify functional environments rather than named sites or specific locations.
      </p>
    </div>
    <ul class="ruled-list">
      <li>
        <small>LAB</small><strong>Materials and applied-physics laboratories</strong><span
          >Controlled</span
        >
      </li>
      <li>
        <small>INS</small><strong>Instrumentation assembly and calibration areas</strong><span
          >Measured</span
        >
      </li>
      <li>
        <small>ENV</small><strong>Environmental preparation and analysis spaces</strong><span
          >Observed</span
        >
      </li>
      <li>
        <small>FLD</small><strong>Field staging, sampling, and custody operations</strong><span
          >Mobile</span
        >
      </li>
      <li>
        <small>REC</small><strong>Technical records and procedure review</strong><span
          >Traceable</span
        >
      </li>
    </ul>
  </section>

  <section class="section section--dark" data-reveal>
    <div class="section__heading">
      <p class="section-label">Safety systems</p>
      <h2>Access and operating condition are recorded separately.</h2>
      <p>
        Physical access levels, endorsements, and facility conditions support the work without
        replacing information classification or program permission.
      </p>
    </div>
    <div class="button-row">
      <a class="button" href="/records/security/physical-access/">Physical access reference</a>
    </div>
  </section>
</CorporateLayout>
