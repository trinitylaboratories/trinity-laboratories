---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import PageHero from '../components/PageHero.astro';
---

<CorporateLayout
  title="Facilities"
  description="Laboratory, instrumentation, environmental, and field research environments."
  active="facilities"
>
  <PageHero
    eyebrow="Operating environments"
    title="Spaces organized around the integrity of the work."
    intro="Facility planning follows the movement of material, instruments, personnel, and records through a documented research process."
    index="TL / FACILITIES"
  />

  <section class="section" data-reveal>
    <MediaFrame
      aspect="wide"
      alt="Abstract diagram representing controlled research environments"
      label="Research environments"
      caption="Laboratory, analytical, and field operations"
    />
  </section>

  <section class="section" data-reveal>
    <div class="section__heading">
      <p class="section-label">Environment types</p>
      <h2>Capability follows the work.</h2>
      <p>
        Facilities are configured around analytical function, sample flow, environmental control,
        and the requirements of the work.
      </p>
    </div>
    <ul class="ruled-list">
      <li>
        <small>LAB</small><strong>Materials and applied-physics laboratories</strong><span
          >Laboratory</span
        >
      </li>
      <li>
        <small>INS</small><strong>Instrumentation assembly and calibration areas</strong><span
          >Measured</span
        >
      </li>
      <li>
        <small>ENV</small><strong>Environmental preparation and analysis spaces</strong><span
          >Observed</span
        >
      </li>
      <li>
        <small>FLD</small><strong>Field staging, sampling, and custody operations</strong><span
          >Mobile</span
        >
      </li>
      <li>
        <small>REC</small><strong>Technical records and procedure review</strong><span
          >Traceable</span
        >
      </li>
    </ul>
  </section>

  <section class="section section--dark" data-reveal>
    <div class="section__heading">
      <p class="section-label">Safety systems</p>
      <h2>Safety and documentation support routine operations.</h2>
      <p>
        Laboratory controls, maintenance records, operating procedures, and review checkpoints
        support consistent work across laboratory and field settings.
      </p>
    </div>
    <div class="button-row">
      <a class="button" href="/contact/">Facility inquiries</a>
    </div>
  </section>
</CorporateLayout>
