---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import PageHero from '../components/PageHero.astro';
---

<CorporateLayout
  title="Facilities"
  description="Laboratory, instrumentation, environmental, and field research environments."
  active="facilities"
>
  <PageHero
    eyebrow="Facilities"
    title="From sample to result."
    intro="Laboratory spaces, instruments, and field support for each stage of your research."
    index="TL / FACILITIES"
  />

  <section class="section" data-reveal>
    <MediaFrame
      src="/media/facilities/core-sample-review.webp"
      aspect="wide"
      alt="Core samples prepared at a laboratory bench for observation and analytical review"
      focalPoint="48% 56%"
      caption="Core sample preparation, observation, and analytical review."
      credit="Trinity Laboratories"
    />
  </section>

  <section class="section" data-reveal>
    <div class="section__heading">
      <p class="section-label">Laboratory and field environments</p>
      <h2>A place for every stage.</h2>
      <p>Prepare samples, check instruments, collect observations, and review the results.</p>
    </div>
    <ul class="ruled-list">
      <li>
        <small>LAB</small><strong>Materials and applied-physics laboratories</strong><span
          >Testing &amp; evaluation</span
        >
      </li>
      <li>
        <small>INS</small><strong>Instrumentation assembly and calibration areas</strong><span
          >Assembly &amp; calibration</span
        >
      </li>
      <li>
        <small>ENV</small><strong>Environmental preparation and analysis spaces</strong><span
          >Preparation &amp; analysis</span
        >
      </li>
      <li>
        <small>FLD</small><strong>Field staging, sampling, and custody operations</strong><span
          >Field support</span
        >
      </li>
      <li>
        <small>REC</small><strong>Technical records and procedure review</strong><span
          >Documentation &amp; review</span
        >
      </li>
    </ul>
  </section>

  <section class="section section--dark" data-reveal>
    <div class="section__heading">
      <p class="section-label">Safety systems</p>
      <h2>Everyday checks matter.</h2>
      <p>
        Maintenance, clear procedures, and regular checks support consistent laboratory and field
        work.
      </p>
    </div>
    <div class="button-row">
      <a class="button" href="/contact/">Ask about our facilities</a>
    </div>
  </section>
</CorporateLayout>
