---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import { CAPABILITIES } from '../lib/capabilities';
---

<CorporateLayout
  title="Trinity Laboratories"
  description="Trinity Laboratories brings together applied research, technical evaluation, instrumentation, and field work."
>
  <section class="home-hero">
    <div class="home-hero__grid" aria-hidden="true"></div>
    <div class="home-hero__media" data-hero-media>
      <img
        src="/media/facilities/instrumented-testing.webp"
        width="1600"
        height="900"
        alt="Instrumented testing equipment prepared for a controlled laboratory evaluation"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="home-hero__copy">
      <p class="eyebrow">Applied research &amp; technical services</p>
      <h1>Trinity<br />Laboratories</h1>
      <p class="home-hero__statement">Careful research for practical questions.</p>
      <div class="button-row">
        <a class="button button--primary" href="/research/">Explore our research</a>
        <a class="button" href="/studies/">Take part in a study</a>
        <a class="button" href="/publications/">Publications</a>
      </div>
    </div>
    <div class="home-hero__register">
      <span>Laboratory research</span>
      <span>Technical evaluation</span>
      <span>Field support</span>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="section__heading">
      <p class="section-label">01 / What we do</p>
      <h2>From the laboratory to the field.</h2>
      <p>
        Trinity Laboratories brings together laboratory research, measurement systems, field
        methods, and clear technical reporting.
      </p>
    </div>
    <div class="editorial-grid">
      <p class="prose-large">
        Our work starts with a clear question and ends with findings that can be understood and
        used.
      </p>
      <div>
        <p>
          Each project uses a defined method, appropriate instruments, and documentation that makes
          the work easier to review and repeat.
        </p>
        <a class="button" href="/about/">How we work</a>
      </div>
    </div>
  </section>

  <section class="section section--dark" data-reveal>
    <div class="section__heading">
      <p class="section-label">02 / Areas of expertise</p>
      <h2>Eight areas of research and technical work.</h2>
      <p>Projects may focus on one discipline or combine several, depending on the question.</p>
    </div>
    <ol class="ruled-list capability-list">
      {
        CAPABILITIES.map((capability) => (
          <li>
            <a href={`/research/${capability.slug}/`}>
              <small>{capability.index}</small>
              <strong>{capability.title}</strong>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="button-row">
      <a class="button" href="/research/">Explore our research</a>
      <a class="button" href="/studies/">Browse participant studies</a>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="section__heading">
      <p class="section-label">03 / Facilities</p>
      <h2>Spaces and systems that support careful work.</h2>
      <p>
        Our work moves between laboratory, instrumentation, environmental, and field settings as
        each project requires.
      </p>
    </div>
    <MediaFrame
      src="/media/facilities/core-sample-review.webp"
      aspect="wide"
      alt="Prepared core samples arranged for observation and analytical review"
      focalPoint="48% 56%"
      caption="Core sample preparation, observation, and analytical review."
      credit="Trinity Laboratories"
    />
    <div class="button-row"><a class="button" href="/facilities/">Explore our facilities</a></div>
  </section>

  <section class="section" data-reveal>
    <div class="section__heading">
      <p class="section-label">04 / Careers</p>
      <h2>Bring your expertise to careful, collaborative work.</h2>
      <p>
        Explore the disciplines represented across our work and tell us where your experience fits.
      </p>
    </div>
    <div class="button-row">
      <a class="button button--primary" href="/careers/">View careers</a>
    </div>
  </section>

  <section class="section closing" data-reveal>
    <p class="section-label">05 / Learn more</p>
    <h2>Have a question about our work?</h2>
    <div class="button-row">
      <a class="button button--primary" href="/publications/">Public information</a>
      <a class="button" href="/contact/">Contact us</a>
      <a class="button" href="/employee-access/">Employee access</a>
    </div>
  </section>
</CorporateLayout>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: calc(100svh - 7.3rem);
    overflow: hidden;
    align-items: end;
    padding: clamp(3.5rem, 8vw, 8rem) var(--page-gutter) clamp(3rem, 7vw, 6rem);
    background: var(--blue-black);
    color: #fff;
  }

  .home-hero::before {
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(2, 10, 20, 0.94) 0%,
        rgba(3, 17, 32, 0.78) 43%,
        rgba(3, 17, 32, 0.16) 78%
      ),
      linear-gradient(0deg, rgba(2, 10, 20, 0.68) 0%, transparent 52%);
    content: '';
  }

  .home-hero::after {
    position: absolute;
    z-index: -1;
    right: 0;
    bottom: 0;
    left: 0;
    height: 0.45rem;
    background: var(--blue);
    content: '';
    animation: line-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
    transform-origin: left;
  }

  .home-hero__copy,
  .home-hero__register {
    position: relative;
    z-index: 2;
    width: min(100%, var(--content-max));
    margin-inline: auto;
  }

  .home-hero h1 {
    max-width: 10ch;
    margin: 1rem 0 0;
    font-size: clamp(4.1rem, 10vw, 9.4rem);
    font-weight: 520;
    letter-spacing: -0.075em;
    line-height: 0.77;
    animation: hero-in 800ms 120ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .home-hero__statement {
    max-width: 30rem;
    margin: 2.4rem 0 0;
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    color: #f1f5fb;
  }

  .home-hero__register {
    display: flex;
    justify-content: flex-end;
    gap: 1.5rem;
    margin-top: 3rem;
    font: 400 0.64rem/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c9d7e8;
  }

  .home-hero__grid {
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.22) 1px, transparent 1px);
    background-size: 5rem 5rem;
    mask-image: linear-gradient(90deg, #000 4%, transparent 72%);
  }

  .home-hero__media {
    position: absolute;
    z-index: -3;
    inset: 0;
    overflow: hidden;
  }

  .home-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 48%;
    animation: image-in 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
    transform-origin: center;
  }

  .home-hero .eyebrow {
    color: #a9cfff;
  }

  .home-hero .button:not(.button--primary) {
    border-color: rgba(255, 255, 255, 0.72);
    color: #fff;
  }

  .capability-list {
    max-width: calc(var(--content-max) - 2 * var(--page-gutter));
  }

  .capability-list li {
    display: block;
    min-height: 0;
    padding: 0;
    border-bottom: 0;
  }

  .capability-list a {
    color: inherit;
  }

  .closing h2 {
    max-width: 18ch;
    margin: 1rem 0 2rem;
    font-size: clamp(2.8rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(2.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes line-in {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes image-in {
    from {
      opacity: 0.72;
      transform: scale(1.035);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 52rem) {
    .home-hero {
      min-height: calc(100svh - 6.5rem);
    }

    .home-hero::before {
      background:
        linear-gradient(90deg, rgba(2, 10, 20, 0.9), rgba(3, 17, 32, 0.54)),
        linear-gradient(0deg, rgba(2, 10, 20, 0.86) 0%, transparent 70%);
    }

    .home-hero__media img {
      object-position: 64% 50%;
    }

    .home-hero__register {
      justify-content: flex-start;
      flex-wrap: wrap;
    }
  }
</style>
