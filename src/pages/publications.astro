---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<CorporateLayout
  title="Publications"
  description="Public information and institutional resources from Trinity Laboratories."
  active="publications"
>
  <PageHero
    eyebrow="Public information"
    title="Publications and institutional resources."
    intro="Public-facing material provides an overview of Trinity Laboratories, its applied-research capabilities, and its operating environments."
    index="TRINITY LABORATORIES / PUBLIC INFORMATION"
  />

  <section class="section" data-reveal>
    <div class="section__heading">
      <p class="section-label">Available resources</p>
      <h2>Information about our work.</h2>
      <p>
        The public site provides high-level information about the institution, its technical
        disciplines, and the environments that support its work.
      </p>
    </div>
    <ul class="ruled-list">
      <li>
        <small>01</small><strong>Institutional profile</strong><a href="/about/">View overview ↗</a>
      </li>
      <li>
        <small>02</small><strong>Research capabilities</strong><a href="/research/"
          >Review capabilities ↗</a
        >
      </li>
      <li>
        <small>03</small><strong>Laboratory and field environments</strong><a href="/facilities/"
          >Review environments ↗</a
        >
      </li>
    </ul>
  </section>

  <section class="section section--dark" data-reveal>
    <div class="section__heading">
      <p class="section-label">Information requests</p>
      <h2>Direct questions to the appropriate channel.</h2>
      <p>
        Availability varies by subject and publication status. Use the inquiry page for
        public-information questions. Employees can use the staff gateway for internal resources.
      </p>
    </div>
    <div class="button-row">
      <a class="button button--primary" href="/contact/">Contact Trinity</a>
      <a class="button" href="/employee-access/">Employee Access</a>
    </div>
  </section>
</CorporateLayout>
