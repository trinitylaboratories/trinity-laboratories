---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<CorporateLayout
  title="Publications"
  description="Research, facility, and publication resources from Trinity Laboratories."
  active="publications"
>
  <PageHero
    eyebrow="Public information"
    title="Resources and publications."
    intro="Explore our research areas, facilities, and approach, or contact us with a specific question."
    index="TL / PUBLICATIONS"
  />

  <section class="section" data-reveal>
    <div class="section__heading">
      <p class="section-label">Explore</p>
      <h2>Start with the area that interests you.</h2>
      <p>
        Learn how Trinity Laboratories approaches research, where the work happens, and which
        technical areas we support.
      </p>
    </div>
    <ul class="ruled-list">
      <li>
        <small>01</small><strong>About Trinity Laboratories</strong><a href="/about/"
          >About Trinity ↗</a
        >
      </li>
      <li>
        <small>02</small><strong>Research capabilities</strong><a href="/research/"
          >Explore research ↗</a
        >
      </li>
      <li>
        <small>03</small><strong>Laboratory and field environments</strong><a href="/facilities/"
          >Explore facilities ↗</a
        >
      </li>
    </ul>
  </section>

  <section class="section section--dark" data-reveal>
    <div class="section__heading">
      <p class="section-label">Questions</p>
      <h2>Looking for something specific?</h2>
      <p>
        Public information varies by subject and availability. Contact us with a question, or use
        Employee Access for internal resources.
      </p>
    </div>
    <div class="button-row">
      <a class="button button--primary" href="/contact/">Send an inquiry</a>
      <a class="button" href="/employee-access/">Employee Access</a>
    </div>
  </section>
</CorporateLayout>
