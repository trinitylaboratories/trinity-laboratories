---
import PortalPageHeading from '../../../components/portal/PortalPageHeading.astro';
import SessionSummary from '../../../components/portal/SessionSummary.astro';
import ControlledRecord from '../../../components/records/ControlledRecord.astro';
import ControlledSection from '../../../components/records/ControlledSection.astro';
import PortalLayout from '../../../layouts/PortalLayout.astro';
---

<PortalLayout
  title="Authorizations"
  description="Review TIRN eligibility and establish temporary TL-3 through TL-6 information access."
  active="authorizations"
>
  <PortalPageHeading
    path="Staff Services / Authorizations"
    title="Authorizations"
    description="Evaluate temporary information access without changing physical authority, endorsements, or facility permissions."
  />

  <div class="portal-workspace">
    <div class="portal-workspace__primary">
      <section class="portal-section" aria-labelledby="authorization-principle-heading">
        <p class="portal-section__label">Access principle</p>
        <h2 id="authorization-principle-heading">Eligibility is not permission</h2>
        <p>
          The base staff session establishes TL-2 information eligibility. A qualifying request may
          establish temporary TL-3 through TL-6 access for the controlled records below. Higher
          levels require progressively stronger release references. Program, compartment, physical,
          and need-to-know requirements remain independent.
        </p>
        <div class="portal-callout">
          Temporary grants expire after 15 minutes and are removed when the staff session is
          terminated. Request references are assigned separately by the controlling office.
        </div>
      </section>

      <ControlledSection
        id="handling-acknowledgment"
        title="Controlled handling acknowledgment"
        mode="authorize"
        requiredLevel="TL-3"
        summary="A temporary TL-3 grant and affirmed need-to-know are required to display this section."
      >
        <p>
          Use controlled material only for the stated working purpose. Do not copy it into an
          unrelated record, unsecured correspondence, or an unapproved distribution list.
        </p>
        <p>
          Relinquish the elevated grant when review is complete. Terminating the staff session also
          removes the temporary authorization.
        </p>
      </ControlledSection>

      <ControlledRecord
        id="training-record-three"
        recordId="TL-TRN-003"
        title="Controlled-record handling exercise"
        mode="authorize"
        requiredLevel="TL-3"
        summary="Required handling exercise for personnel assigned controlled-record review duties."
      >
        <p>
          <strong>Purpose:</strong> Complete the current controlled-information handling review.
        </p>
        <ol>
          <li>Confirm the record marking and approved distribution.</li>
          <li>Review only the information required for the assigned duty.</li>
          <li>Relinquish temporary access when the review is complete.</li>
        </ol>
        <p>Record completion through the assigned training coordinator.</p>
      </ControlledRecord>

      <ControlledSection
        id="release-coordination-four"
        title="Controlled release coordination"
        mode="authorize"
        requiredLevel="TL-4"
        summary="Temporary TL-4 access, an independent control-office reference, and affirmed need-to-know are required."
      >
        <p>
          Confirm the assigned review scope, distribution list, and current revision before using
          material from a special-access release. Record copying and onward distribution remain
          subject to the controlling office instructions.
        </p>
        <p>
          Close the record when the assigned review is complete and relinquish temporary access if
          no additional TL-4 material is required during this session.
        </p>
      </ControlledSection>

      <ControlledSection
        id="directorate-review-five"
        title="Directorate-controlled review acknowledgment"
        mode="authorize"
        requiredLevel="TL-5"
        summary="Temporary TL-5 access, control-office and Directorate release references, and affirmed need-to-know are required."
      >
        <p>
          Confirm the assigned record, authorized working purpose, and current release instruction
          before beginning Directorate-controlled review. Do not extend the review to related
          records unless they are listed in the same assignment.
        </p>
        <p>
          Relinquish the temporary grant when the assigned review is complete or when the stated
          working purpose no longer applies.
        </p>
      </ControlledSection>

      <ControlledSection
        id="isolated-review-six"
        title="Isolated-record review acknowledgment"
        mode="authorize"
        requiredLevel="TL-6"
        summary="Temporary TL-6 access, control-office and Directorate release references, an isolation-register reference, and affirmed need-to-know are required."
      >
        <p>
          Review is limited to the isolated record identified by the assigned access instruction.
          Department, position, facility authority, and prior access do not establish permission for
          another isolated record.
        </p>
        <p>
          End the review immediately if the displayed record differs from the assignment or if any
          required control reference is withdrawn.
        </p>
      </ControlledSection>

      <ControlledSection
        id="separate-source-example"
        title="Separately controlled source record"
        mode="withheld"
        requiredLevel="TL-4"
        program="PROGRAM AUTHORIZATION"
        compartment="COMPARTMENT AUTHORIZATION"
        summary="The source body is not available through this network node."
      />
    </div>

    <aside class="portal-workspace__aside" aria-label="Current access context">
      <SessionSummary />
      <section class="portal-section" aria-labelledby="authorization-results-heading">
        <p class="portal-section__label">Evaluation results</p>
        <h2 id="authorization-results-heading">Possible outcomes</h2>
        <dl class="portal-summary">
          <div><dt>TL-0–TL-2</dt><dd>Base staff session</dd></div>
          <div><dt>TL-3</dt><dd>Authorization reference required</dd></div>
          <div><dt>TL-4</dt><dd>Authorization and control-office references required</dd></div>
          <div><dt>TL-5</dt><dd>Control-office and Directorate release required</dd></div>
          <div><dt>TL-6</dt><dd>Directorate and isolation-register release required</dd></div>
          <div><dt>Program / compartment</dt><dd>Separate authorization required</dd></div>
          <div><dt>TL-7 / TL/Ø</dt><dd>Not available at this node</dd></div>
          <div><dt>Withheld body</dt><dd>Held by controlling office</dd></div>
        </dl>
      </section>
    </aside>
  </div>
</PortalLayout>
