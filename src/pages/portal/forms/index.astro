---
import PortalPageHeading from '../../../components/portal/PortalPageHeading.astro';
import SessionSummary from '../../../components/portal/SessionSummary.astro';
import PortalLayout from '../../../layouts/PortalLayout.astro';

const forms = [
  ['TL-101', 'Routine Research & Technical Activity Record', 'Research'],
  ['TL-220', 'Controlled Experimental Study Record', 'Research'],
  ['TL-340', 'Restricted Phenomena Assessment Record', 'Research'],
  ['TL-470', 'Special Access Anomalous Research Protocol', 'Research'],
  ['TL-590', 'Directorate Exception & Nonstandard Reality Event Record', 'Research'],
  ['TL-P110', 'Personnel Research Assignment Record', 'Personnel'],
  ['TL-P365', 'Restricted Personnel Exposure & Fitness Record', 'Personnel'],
  ['TL-O205', 'Temporary Operational Order', 'Operations'],
  ['TL-N310', 'Emergency Condition Notice', 'Notices'],
  ['TL-N480', 'Anomalous Emergency Action Notice', 'Notices'],
  ['TL-SOP-720', 'Remote Field Expedition', 'Procedure'],
  ['TL-SOP-760', 'Controlled High-Risk Experiment', 'Procedure'],
  ['TL-SOP-890', 'Anomalous Site Expedition & Recovery', 'Procedure'],
  ['TL-X510', 'Executive Directive', 'Executive'],
  ['TL-X595', 'Directorate Executive Order', 'Executive'],
] as const;

const formRoute = (recordId: string) => `/records/forms/${recordId.toLowerCase()}/`;
---

<PortalLayout
  title="Forms"
  description="Browse Trinity blank form templates and open the loopback-only Filing Workstation for local record preparation."
  active="forms"
>
  <PortalPageHeading
    path="Staff Services / Forms"
    title="Forms and filing"
    description="Select an approved blank template, prepare a record locally, and review generated files before publication."
  />

  <div class="portal-workspace">
    <div class="portal-workspace__primary">
      <section class="portal-section" aria-labelledby="filing-workstation-heading">
        <p class="portal-section__label">Local preparation</p>
        <h2 id="filing-workstation-heading">TIRN Filing Workstation</h2>
        <p>
          The workstation runs only on this computer and prepares a review package without sending
          form values to the website. Start it from the project directory before opening the local
          address.
        </p>
        <p class="portal-callout">
          Drafts remain local until a generated package is deliberately added to a repository branch
          and passes review.
        </p>
        <a
          class="portal-button portal-button--primary"
          href="http://127.0.0.1:4319/"
          rel="noreferrer"
          data-filing-workstation-link>Open local Filing Workstation</a
        >
      </section>

      <section class="portal-section" aria-labelledby="forms-library-heading">
        <p class="portal-section__label">Approved templates</p>
        <h2 id="forms-library-heading">Blank forms library</h2>
        <div class="portal-table-wrap">
          <table class="portal-table">
            <thead>
              <tr><th>Record</th><th>Template</th><th>Family</th><th>Source</th></tr>
            </thead>
            <tbody>
              {
                forms.map(([recordId, title, family]) => (
                  <tr>
                    <td>{recordId}</td>
                    <td>{title}</td>
                    <td>{family}</td>
                    <td>
                      <a href={formRoute(recordId)}>Open blank form</a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <aside class="portal-workspace__aside" aria-label="Filing context">
      <SessionSummary />
      <section class="portal-section" aria-labelledby="filing-rules-heading">
        <p class="portal-section__label">Before filing</p>
        <h2 id="filing-rules-heading">Publication checks</h2>
        <ul>
          <li>Use the correct record family and identifier.</li>
          <li>Separate information classification from physical authority.</li>
          <li>Do not place withheld plaintext in a publication package.</li>
          <li>Review the generated diff before committing.</li>
        </ul>
      </section>
    </aside>
  </div>
</PortalLayout>
