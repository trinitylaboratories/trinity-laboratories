---
import { getCollection, type CollectionEntry } from 'astro:content';

import PortalPageHeading from '../../../components/portal/PortalPageHeading.astro';
import SessionSummary from '../../../components/portal/SessionSummary.astro';
import AuthorizationDialog from '../../../components/records/AuthorizationDialog.astro';
import type { TirnLevel } from '../../../lib/tirn-access';
import PortalLayout from '../../../layouts/PortalLayout.astro';

interface PortalForm {
  recordId: string;
  title: string;
  recordFamily: string;
  level: TirnLevel;
  program?: string;
  compartment?: string;
}

const levelRank = new Map([
  ['TL-0', 0],
  ['TL-1', 1],
  ['TL-2', 2],
  ['TL-3', 3],
  ['TL-4', 4],
  ['TL-5', 5],
  ['TL-6', 6],
  ['TL-7', 7],
]);
const forms: PortalForm[] = (await getCollection('docs'))
  .flatMap((document: CollectionEntry<'docs'>): PortalForm[] => {
    const { data } = document;
    if (
      data.recordType !== 'form-template' ||
      !data.recordId ||
      !data.recordFamily ||
      !data.information
    ) {
      return [];
    }
    return [
      {
        recordId: data.recordId,
        title: data.title.replace(/^TL-[A-Z0-9-]+\s+—\s+/, ''),
        recordFamily: data.recordFamily,
        level: data.information.level,
        program: data.information.program,
        compartment: data.information.compartment,
      },
    ];
  })
  .sort((left: PortalForm, right: PortalForm) => left.recordId.localeCompare(right.recordId));

const formRoute = (recordId: string) => `/records/forms/${recordId.toLowerCase()}/`;
const workstationAvailable = import.meta.env.DEV;
---

<PortalLayout
  title="Forms"
  description="Browse Trinity blank form templates and prepare filing packages from a configured local terminal."
  active="forms"
>
  <PortalPageHeading
    path="Staff Services / Forms"
    title="Forms and filing"
    description="Select an approved blank template, prepare a record locally, and review generated files before publication."
  />

  <div class="portal-workspace">
    <div class="portal-workspace__primary">
      <section class="portal-section" aria-labelledby="filing-workstation-heading">
        <p class="portal-section__label">Local preparation</p>
        <h2 id="filing-workstation-heading">TIRN Filing Workstation</h2>
        <p>
          The workstation is available only from a configured local terminal. It prepares a review
          package without routing working values through the records network.
        </p>
        <p class="portal-callout">
          Drafts remain in local custody until a generated package passes records-control review.
        </p>
        {
          workstationAvailable ? (
            <a
              class="portal-button portal-button--primary"
              href="http://127.0.0.1:4319/"
              rel="noreferrer"
              data-filing-workstation-link
            >
              Open local Filing Workstation
            </a>
          ) : (
            <p class="portal-callout portal-callout--warning" data-filing-workstation-status>
              Filing Workstation unavailable from this terminal. Use a configured local records
              workstation to prepare a package.
            </p>
          )
        }
      </section>

      <section class="portal-section" aria-labelledby="forms-library-heading">
        <p class="portal-section__label">Approved templates</p>
        <h2 id="forms-library-heading">Blank forms library</h2>
        <div class="portal-table-wrap">
          <table class="portal-table">
            <thead>
              <tr>
                <th>Record</th><th>Template</th><th>Family</th><th>Eligibility</th><th>Action</th>
              </tr>
            </thead>
            <tbody>
              {
                forms.map((form) => {
                  const rank = levelRank.get(form.level) ?? Number.MAX_VALUE;
                  const requestLevel = rank === 3 ? 'TL-3' : 'TL-4';
                  return (
                    <tr data-form-register-row data-required-level={form.level}>
                      <td>{form.recordId}</td>
                      <td>
                        <span data-form-title hidden>
                          {form.title}
                        </span>
                        <span data-form-title-fallback>Controlled template</span>
                      </td>
                      <td>{form.recordFamily}</td>
                      <td>{form.level}</td>
                      <td>
                        {rank <= 2 && <a href={formRoute(form.recordId)}>Open blank form</a>}
                        {rank >= 3 && rank <= 4 && (
                          <div class="portal-record-actions">
                            <a href={formRoute(form.recordId)}>Review control record</a>
                            <AuthorizationDialog
                              id={`forms-${form.recordId.toLowerCase()}`}
                              requiredLevel={requestLevel}
                              program={form.program}
                              compartment={form.compartment}
                              triggerLabel="Request access"
                            />
                          </div>
                        )}
                        {rank > 4 && (
                          <span class="portal-muted-status">Separate authorization required</span>
                        )}
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <aside class="portal-workspace__aside" aria-label="Filing context">
      <SessionSummary />
      <section class="portal-section" aria-labelledby="filing-rules-heading">
        <p class="portal-section__label">Before filing</p>
        <h2 id="filing-rules-heading">Publication checks</h2>
        <ul>
          <li>Use the correct record family and identifier.</li>
          <li>Separate information classification from physical authority.</li>
          <li>Do not place withheld plaintext in a publication package.</li>
          <li>Review the complete generated package before release.</li>
        </ul>
      </section>
    </aside>
  </div>
</PortalLayout>

<script>
  import {
    accessAllows,
    resolveTirnAccess,
    TIRN_ACCESS_CHANGE_EVENT,
    TIRN_GRANT_STORAGE_KEY,
    TIRN_SESSION_STORAGE_KEY,
    type TirnLevel,
  } from '../../../lib/tirn-access';

  const readFormAccessValue = (key: string) => {
    try {
      return sessionStorage.getItem(key);
    } catch {
      return null;
    }
  };

  const refreshFormRegister = () => {
    const state = resolveTirnAccess(
      readFormAccessValue(TIRN_SESSION_STORAGE_KEY),
      readFormAccessValue(TIRN_GRANT_STORAGE_KEY),
      Date.now(),
    );

    document.querySelectorAll<HTMLElement>('[data-form-register-row]').forEach((row) => {
      const requiredLevel = (row.dataset.requiredLevel || 'TL-2') as TirnLevel;
      const authorized = accessAllows(state, requiredLevel);
      const title = row.querySelector<HTMLElement>('[data-form-title]');
      const fallback = row.querySelector<HTMLElement>('[data-form-title-fallback]');
      if (title) title.hidden = !authorized;
      if (fallback) fallback.hidden = authorized;
    });
  };

  refreshFormRegister();
  window.addEventListener(TIRN_ACCESS_CHANGE_EVENT, refreshFormRegister);
  window.setInterval(refreshFormRegister, 1000);
</script>
