---
import PortalPageHeading from '../../../components/portal/PortalPageHeading.astro';
import SessionSummary from '../../../components/portal/SessionSummary.astro';
import PortalLayout from '../../../layouts/PortalLayout.astro';
---

<PortalLayout
  title="Help"
  description="Operational guidance for TIRN staff sessions, temporary authorization, records access, and filing."
  active="help"
>
  <PortalPageHeading
    path="Staff Services / Help"
    title="Access and filing help"
    description="Reference the expected session states and recovery steps before reporting an access problem."
  />

  <div class="portal-workspace">
    <div class="portal-workspace__primary">
      <section class="portal-section" aria-labelledby="session-help-heading">
        <p class="portal-section__label">Session access</p>
        <h2 id="session-help-heading">Establish a staff session</h2>
        <ol>
          <li>Open <a href="/employee-access/">Employee Access</a>.</li>
          <li>Enter a badge identifier and issue the six-character terminal code.</li>
          <li>Enter the code before its five-minute expiry.</li>
          <li>Confirm that Staff Services reports “Staff / TL-2 base.”</li>
        </ol>
        <p>
          Badge identifiers and terminal codes are cleared after the access sequence. The staff
          session remains active on this terminal until it is terminated.
        </p>
      </section>

      <section class="portal-section" aria-labelledby="elevation-help-heading">
        <p class="portal-section__label">Controlled information</p>
        <h2 id="elevation-help-heading">Request temporary controlled access</h2>
        <ol>
          <li>Open a controlled section or record and select <strong>Request access</strong>.</li>
          <li>Select the working purpose and enter the assigned authorization reference.</li>
          <li>For TL-4 and above, enter the independent control-office reference.</li>
          <li>For TL-5 and TL-6, enter the assigned Directorate release reference.</li>
          <li>For TL-6, also enter the named-access isolation-register reference.</li>
          <li>Affirm need-to-know and evaluate the request.</li>
          <li>Relinquish the grant when review is complete.</li>
        </ol>
        <p class="portal-callout portal-callout--warning">
          Temporary session authorization does not satisfy TL-7, TL/Ø, named program, compartment,
          endorsement, or physical-access requirements.
        </p>
      </section>

      <section class="portal-section" aria-labelledby="filing-help-heading">
        <p class="portal-section__label">Records preparation</p>
        <h2 id="filing-help-heading">Prepare a new record</h2>
        <p>
          Use a designated Filing Workstation, select the current approved template, complete the
          required fields, and obtain supervisory review. Route the completed record to Records
          Control for identifier, revision, and distribution review.
        </p>
        <a class="portal-button" href="/portal/forms/">Open forms and filing</a>
      </section>

      <section class="portal-section" aria-labelledby="outcomes-heading">
        <p class="portal-section__label">Troubleshooting</p>
        <h2 id="outcomes-heading">Expected outcomes</h2>
        <div class="portal-table-wrap">
          <table class="portal-table">
            <thead><tr><th>Message</th><th>Meaning</th><th>Action</th></tr></thead>
            <tbody>
              <tr>
                <td>Guest / no staff session</td>
                <td>No base staff session is present.</td>
                <td>Return to Employee Access.</td>
              </tr>
              <tr>
                <td>Enter an authorization reference</td>
                <td>The reference is missing or does not match the requested level.</td>
                <td>Check the assigned request reference and retain the completed fields.</td>
              </tr>
              <tr>
                <td>Separate grant required</td>
                <td
                  >The record requires TL-7, TL/Ø, a program, or a compartment unavailable at this
                  node.</td
                >
                <td>Use the released metadata only.</td>
              </tr>
              <tr>
                <td>Content withheld</td>
                <td>The source record is held by its controlling office.</td>
                <td>Contact the controlling office for release instructions.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <aside class="portal-workspace__aside" aria-label="Current access context">
      <SessionSummary />
      <section class="portal-section" aria-labelledby="privacy-heading">
        <p class="portal-section__label">Session administration</p>
        <h2 id="privacy-heading">Session controls</h2>
        <dl class="portal-summary">
          <div><dt>Staff session</dt><dd>Active until termination</dd></div>
          <div><dt>Temporary authorization</dt><dd>Level, scope, and expiry</dd></div>
          <div><dt>Request references</dt><dd>Cleared after evaluation</dd></div>
          <div><dt>Working purpose</dt><dd>Cleared after evaluation</dd></div>
          <div><dt>Records routing</dt><dd>Through Records Control</dd></div>
        </dl>
      </section>
    </aside>
  </div>
</PortalLayout>
