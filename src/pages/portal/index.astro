---
import { getCollection, type CollectionEntry } from 'astro:content';

import PortalPageHeading from '../../components/portal/PortalPageHeading.astro';
import SessionSummary from '../../components/portal/SessionSummary.astro';
import {
  catalogueEntryFromDocument,
  catalogueEntryFromSubmission,
  sortCatalogueEntries,
  type CatalogueDocumentData,
  type RecordCatalogueEntry,
} from '../../lib/record-catalogue';
import type { SubmissionRecordData } from '../../lib/submission-schema';
import PortalLayout from '../../layouts/PortalLayout.astro';

const documents = await getCollection('docs');
const submissions = await getCollection('submissions');
const documentEntries: RecordCatalogueEntry[] = documents.flatMap(
  (document: CollectionEntry<'docs'>): RecordCatalogueEntry[] => {
    const entry = catalogueEntryFromDocument(document.id, document.data as CatalogueDocumentData);
    return entry ? [entry] : [];
  },
);
const submissionEntries = sortCatalogueEntries(
  submissions.map((submission: CollectionEntry<'submissions'>) =>
    catalogueEntryFromSubmission(submission.data as SubmissionRecordData),
  ),
);
const canonicalRecordCount = documentEntries.length + submissionEntries.length;
const formCount = documentEntries.filter(
  ({ recordType }: RecordCatalogueEntry) => recordType === 'form-template',
).length;
const securityCount = documentEntries.filter(
  ({ recordFamily }: RecordCatalogueEntry) => recordFamily === 'security',
).length;
const personnelCount = submissionEntries.filter(
  ({ recordFamily }: RecordCatalogueEntry) => recordFamily === 'personnel',
).length;
---

<PortalLayout
  title="Staff Home"
  description="TIRN Staff Services provides current session status, records references, forms, and authorization controls."
  active="home"
>
  <PortalPageHeading
    path="Staff Services / Home"
    title="Staff home"
    description="Routine access to released records, blank forms, and session authorization controls."
  />

  <div class="portal-workspace">
    <div class="portal-workspace__primary">
      <section class="portal-section" aria-labelledby="records-heading">
        <p class="portal-section__label">Records control</p>
        <h2 id="records-heading">Available records services</h2>
        <div class="portal-table-wrap">
          <table class="portal-table">
            <thead>
              <tr><th>Service</th><th>Current holdings</th><th>Action</th></tr>
            </thead>
            <tbody>
              <tr>
                <td>Records catalogue</td>
                <td>{canonicalRecordCount} canonical entries</td>
                <td><a href="/portal/records/">Open catalogue</a></td>
              </tr>
              <tr>
                <td>Completed reports</td>
                <td>{submissionEntries.length} registered</td>
                <td><a href="/records/reports/">Open register</a></td>
              </tr>
              <tr>
                <td>Personnel files</td>
                <td>{personnelCount} controlled files</td>
                <td><a href="/portal/personnel/">Open personnel register</a></td>
              </tr>
              <tr>
                <td>Security references</td>
                <td>{securityCount} active records</td>
                <td><a href="/records/security/">Open references</a></td>
              </tr>
              <tr>
                <td>Forms library</td>
                <td>{formCount} blank templates</td>
                <td><a href="/portal/forms/">Review forms</a></td>
              </tr>
              <tr>
                <td>Temporary authorization</td>
                <td>TL-3 / TL-4 request review</td>
                <td><a href="/portal/authorizations/">Open console</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="portal-section" aria-labelledby="recent-records-heading">
        <p class="portal-section__label">Register activity</p>
        <h2 id="recent-records-heading">Latest effective records</h2>
        {
          submissionEntries.length > 0 ? (
            <div class="portal-table-wrap">
              <table class="portal-table">
                <thead>
                  <tr>
                    <>
                      <th>Record</th>
                      <th>Title</th>
                      <th>Status</th>
                      <th>Effective</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {submissionEntries.slice(0, 5).map((entry) => (
                    <tr
                      data-portal-recent-record
                      data-required-level={entry.informationLevel ?? 'TL-2'}
                      data-publication-state={entry.publicationState}
                    >
                      <td>
                        <a href={entry.href}>{entry.recordId}</a>
                      </td>
                      <td>
                        <span data-portal-recent-title hidden>
                          {entry.title}
                        </span>
                        <span data-portal-recent-title-fallback>
                          Controlled report — eligibility required
                        </span>
                      </td>
                      <td>{entry.status}</td>
                      <td>
                        {entry.effectiveDate ? (
                          <time datetime={entry.effectiveDate}>{entry.effectiveDate}</time>
                        ) : (
                          'Undated'
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="portal-empty">
              <strong>No effective records</strong>
              <span>The completed-record register contains no current entries.</span>
            </div>
          )
        }
      </section>

      <section class="portal-section" aria-labelledby="common-tasks-heading">
        <p class="portal-section__label">Navigation</p>
        <h2 id="common-tasks-heading">Common tasks</h2>
        <ul class="portal-actions">
          <li><a href="/portal/records/">Filter the canonical records catalogue</a></li>
          <li><a href="/portal/personnel/">Review controlled personnel files</a></li>
          <li><a href="/records/search/">Search TIRN released records</a></li>
          <li><a href="/records/research/">Review research-administration references</a></li>
          <li>
            <a href="/records/security/information-classification/">Check information eligibility</a
            >
          </li>
          <li><a href="/records/security/physical-access/">Check physical authority rules</a></li>
          <li><a href="/portal/help/">Review access and session help</a></li>
        </ul>
      </section>
    </div>

    <aside class="portal-workspace__aside" aria-label="Session and notices">
      <SessionSummary />
      <section class="portal-section" aria-labelledby="notices-heading">
        <p class="portal-section__label">Notices</p>
        <h2 id="notices-heading">Staff notices</h2>
        <div class="portal-empty">
          <strong>No active notices</strong>
          <span>No staff-services notices apply to the current session.</span>
        </div>
      </section>
    </aside>
  </div>
</PortalLayout>

<script>
  import {
    accessAllows,
    resolveTirnAccess,
    TIRN_ACCESS_CHANGE_EVENT,
    TIRN_GRANT_STORAGE_KEY,
    TIRN_SESSION_STORAGE_KEY,
    type TirnLevel,
  } from '../../lib/tirn-access';

  const readRecentRecordAccessValue = (key: string) => {
    try {
      return sessionStorage.getItem(key);
    } catch {
      return null;
    }
  };

  const refreshRecentRecordTitles = () => {
    const state = resolveTirnAccess(
      readRecentRecordAccessValue(TIRN_SESSION_STORAGE_KEY),
      readRecentRecordAccessValue(TIRN_GRANT_STORAGE_KEY),
      Date.now(),
    );
    document.querySelectorAll<HTMLElement>('[data-portal-recent-record]').forEach((row) => {
      const requiredLevel = (row.dataset.requiredLevel || 'TL-2') as TirnLevel;
      const authorized =
        row.dataset.publicationState !== 'withheld' && accessAllows(state, requiredLevel);
      const title = row.querySelector<HTMLElement>('[data-portal-recent-title]');
      const fallback = row.querySelector<HTMLElement>('[data-portal-recent-title-fallback]');
      if (title) title.hidden = !authorized;
      if (fallback) fallback.hidden = authorized;
    });
  };

  refreshRecentRecordTitles();
  window.addEventListener(TIRN_ACCESS_CHANGE_EVENT, refreshRecentRecordTitles);
  window.setInterval(refreshRecentRecordTitles, 1000);
</script>
