---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import LocalForm from '../components/LocalForm.astro';
import PageHero from '../components/PageHero.astro';
---

<CorporateLayout
  title="Contact"
  description="Contact Trinity Laboratories about research, facilities, publications, careers, or general questions."
  active="contact"
>
  <PageHero
    eyebrow="Contact"
    title="How can we help?"
    intro="Choose a topic and share a little context about your question."
    index="TL / CONTACT"
  />

  <section class="section" data-reveal>
    <div class="section__heading">
      <p class="section-label">Send an inquiry</p>
      <h2>Tell us what you’d like to discuss.</h2>
      <p>
        Use this form for questions about research, facilities, publications, careers, or Trinity
        Laboratories generally.
      </p>
    </div>
    <LocalForm
      kind="contact"
      submitLabel="Submit inquiry"
      successMessage="Thank you. Your form is complete."
    >
      <label for="contact-name"
        >Full name <input id="contact-name" type="text" required autocomplete="off" /></label
      >
      <label for="contact-organization"
        >Organization <input
          id="contact-organization"
          type="text"
          required
          autocomplete="off"
        /></label
      >
      <label for="contact-email"
        >Email address <input id="contact-email" type="email" required autocomplete="off" /></label
      >
      <label for="contact-category"
        >Inquiry category
        <select id="contact-category" required>
          <option value="">Select a category</option><option>Research</option><option
            >Facilities</option
          ><option>Publications</option><option>Careers</option><option>General</option>
        </select>
      </label>
      <label for="contact-message" data-wide
        >Message <textarea id="contact-message" required minlength="20" autocomplete="off"
        ></textarea></label
      >
    </LocalForm>
  </section>
</CorporateLayout>
