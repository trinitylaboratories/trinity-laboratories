---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import LocalForm from '../components/LocalForm.astro';
import PageHero from '../components/PageHero.astro';
---

<CorporateLayout
  title="Contact"
  description="Direct an institutional inquiry to Trinity Laboratories."
  active="contact"
>
  <PageHero
    eyebrow="Contact"
    title="Direct an inquiry."
    intro="Route questions by subject so the relevant technical or institutional group can review the request."
    index="TL / CONTACT"
  />

  <section class="section" data-reveal>
    <div class="section__heading">
      <p class="section-label">Inquiry routing</p>
      <h2>Provide the question and operating context.</h2>
      <p>
        Research, facility, publication, career, and general institutional inquiries use the same
        controlled terminal.
      </p>
    </div>
    <LocalForm
      kind="contact"
      submitLabel="Submit inquiry"
      successMessage="INQUIRY ACCEPTED. TERMINAL CLEARED."
    >
      <label for="contact-name"
        >Full name <input id="contact-name" type="text" required autocomplete="off" /></label
      >
      <label for="contact-organization"
        >Organization <input
          id="contact-organization"
          type="text"
          required
          autocomplete="off"
        /></label
      >
      <label for="contact-email"
        >Email address <input id="contact-email" type="email" required autocomplete="off" /></label
      >
      <label for="contact-category"
        >Inquiry category
        <select id="contact-category" required>
          <option value="">Select a category</option><option>Research</option><option
            >Facilities</option
          ><option>Publications</option><option>Careers</option><option>General</option>
        </select>
      </label>
      <label for="contact-message" data-wide
        >Message <textarea id="contact-message" required minlength="20" autocomplete="off"
        ></textarea></label
      >
    </LocalForm>
  </section>
</CorporateLayout>
