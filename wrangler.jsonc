{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trinity-laboratories",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": true,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "trinitylaboratories.org",
      "custom_domain": true,
    },
  ],
}
