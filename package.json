{
  "name": "trinity-laboratories",
  "version": "0.1.0",
  "private": true,
  "description": "The open-source static website and fictional institutional archive for Trinity Laboratories.",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev",
    "dev:host": "node scripts/run-astro.mjs dev --host",
    "build": "node scripts/build-site.mjs",
    "build:production": "cross-env PUBLIC_INDEXABLE=true node scripts/build-site.mjs",
    "build:preview": "cross-env PUBLIC_INDEXABLE=false node scripts/build-site.mjs",
    "preview": "node scripts/run-astro.mjs preview",
    "preview:cloudflare": "wrangler dev --local --port 4321",
    "sync": "node scripts/run-astro.mjs sync",
    "check": "node scripts/run-astro.mjs check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "browser:install": "cross-env PLAYWRIGHT_BROWSERS_PATH=.tools/ms-playwright playwright install chromium",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=.tools/ms-playwright playwright test",
    "record-desk": "node scripts/record-desk-server.mjs",
    "record-desk:validate": "node scripts/validate-form-definitions.mjs",
    "record-desk:import": "node scripts/import-record.mjs",
    "validate:repo": "node scripts/validate-repository.mjs",
    "validate:assets": "node scripts/validate-assets.mjs --root public",
    "validate:dist": "node scripts/validate-assets.mjs --root dist --skip-ledger",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:submissions": "node scripts/validate-submissions.mjs",
    "validate:site": "node scripts/validate-built-site.mjs --dist dist",
    "validate:site:production": "node scripts/validate-built-site.mjs --environment production --dist dist",
    "validate:site:preview": "node scripts/validate-built-site.mjs --environment preview --dist dist",
    "verify:production": "node scripts/verify-indexability.mjs --url https://trinitylaboratories.org --environment production",
    "prepare:deploy": "node scripts/prepare-deploy.mjs --dist dist",
    "prepare:deploy:production": "node scripts/prepare-deploy.mjs --environment production --dist dist",
    "audit": "npm audit --audit-level=high",
    "cf:dev": "npm run build && wrangler dev",
    "cf:install": "node scripts/install-locked.mjs",
    "cf:build": "npm run validate:repo && npm run validate:assets && npm run validate:content && npm run record-desk:validate && npm run validate:submissions && npm run audit && npm run lint && npm run check && npm run test:unit && npm run build && npm run prepare:deploy && npm run validate:dist && npm run validate:site",
    "cf:deploy": "node scripts/deploy-site.mjs",
    "deploy": "npm run cf:build && npm run cf:deploy",
    "deploy:preview": "cross-env SITE_DEPLOYMENT_ENV=preview PUBLIC_INDEXABLE=false npm run deploy",
    "deploy:production": "cross-env SITE_DEPLOYMENT_ENV=production PUBLIC_INDEXABLE=true npm run deploy",
    "validate": "npm run validate:repo && npm run validate:assets && npm run validate:content && npm run record-desk:validate && npm run validate:submissions && npm run audit && npm run lint && npm run check && npm run test:unit && npm run build:production && npm run prepare:deploy:production && npm run validate:dist && npm run validate:site:production"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "@pagefind/default-ui": "^1.5.2",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "fflate": "^0.8.3",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0",
    "yaml": "^2.9.0"
  }
}
